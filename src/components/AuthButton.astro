---
// AuthButton.astro
---
<div id="auth-widget" class="auth-widget">
  <button id="auth-trigger" class="auth-trigger" aria-label="Login" title="Login">
    <!-- Default Login Icon (User stroke icon) -->
    <svg id="auth-icon-login" viewBox="0 0 24 24" style="display: block;">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
      <circle cx="12" cy="7" r="4"></circle>
    </svg>
    <!-- Profile Picture Container (Hidden initially) -->
    <img id="auth-icon-pfp" src="https://sudothy.me/media/vanity/fallback.png" alt="Profile" style="display: none;" />
  </button>
  
  <div id="auth-dropdown" class="auth-dropdown">
    <button class="dropdown-item" id="btn-my-profile">
      <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      My Profile
    </button>
    <button class="dropdown-item admin-only" id="btn-admin-users" style="display: none;">
      <svg viewBox="0 0 24 24"><path d="M12 11c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-8 10c0-2.66 5.33-4 8-4s8 1.34 8 4"></path></svg>
      Users
    </button>
    <div class="dropdown-divider"></div>
    <button class="dropdown-item" id="btn-logout">
      <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
      Log Out
    </button>
  </div>
</div>

<style>
  .auth-widget {
    position: fixed;
    top: clamp(15px, 4vh, 30px);
    right: clamp(15px, 4vw, 30px);
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .auth-trigger, .auth-logout {
    display: flex; align-items: center; justify-content: center;
    background: transparent; border: none; cursor: pointer;
    color: #444; transition: color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    -webkit-tap-highlight-color: transparent; padding: 0;
  }
  .auth-trigger:hover, .auth-logout:hover {
    color: #ffffff;
    transform: scale(1.05);
  }
  .auth-trigger svg, .auth-logout svg {
    width: 28px; height: 28px; stroke: currentColor; stroke-width: 2;
    fill: none; stroke-linecap: round; stroke-linejoin: round;
  }
  #auth-icon-pfp {
    width: 32px; height: 32px; border-radius: 50%; object-fit: cover;
    border: 1px solid var(--border, rgba(255,255,255,0.08));
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
  }
  .auth-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 10px;
    background: rgba(15, 15, 15, 0.85);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    min-width: 160px;
    opacity: 0;
    transform: translateY(-10px) scale(0.95);
    pointer-events: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }
  .auth-dropdown.show {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    border: none;
    color: #e0e0e0;
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-family: inherit;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
    transition: background 0.2s, color 0.2s;
  }
  .dropdown-item:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }
  .dropdown-item svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }
  .dropdown-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin: 6px 0;
  }
</style>

<script>
  import { supabase } from '../lib/supabase.js';

  // Event Delegation (runs ONCE when module is loaded)
  document.addEventListener('click', async (e) => {
    // Open login modal if not logged in
    const trigger = e.target.closest('#auth-trigger');
    const dropdown = document.getElementById('auth-dropdown');
    
    // Check if logged in (basic cookie check for synchronous UI logic)
    const isLoggedIn = document.cookie.includes('sb-auth-token=');
    
    if (trigger) {
      if (!isLoggedIn) {
        window.dispatchEvent(new Event('openAuthModal'));
      } else {
        if (dropdown) {
          dropdown.classList.toggle('show');
        }
      }
    } else {
      // Clicked outside, hide dropdown
      if (dropdown && !dropdown.contains(e.target)) {
        dropdown.classList.remove('show');
      }
    }

    // Logout action
    if (e.target.closest('#btn-logout')) {
      document.cookie = 'sb-auth-token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
      await supabase.auth.signOut();
      window.location.reload();
    }
  });

  // State Hydration (runs on every page load/transition)
  document.addEventListener('astro:page-load', async () => {
    const loginIcon = document.getElementById('auth-icon-login');
    const pfpIcon = document.getElementById('auth-icon-pfp');
    const btnAdminUsers = document.getElementById('btn-admin-users');

    // Check Session properly
    const { data: { session } } = await supabase.auth.getSession();
    
    if (session) {
      // Logged in
      if (loginIcon) loginIcon.style.display = 'none';
      if (pfpIcon) pfpIcon.style.display = 'block';
      
      const role = session.user.user_metadata?.role;
      if (role === 'Admin' && btnAdminUsers) {
        btnAdminUsers.style.display = 'flex';
        btnAdminUsers.onclick = () => window.location.href = '/dashboard';
      }
      
      // Update PFP if available in metadata
      const pfpUrl = session.user.user_metadata?.profile_picture_url;
      if (pfpUrl && pfpIcon) pfpIcon.src = pfpUrl;
      
    } else {
      // Not logged in
      if (loginIcon) loginIcon.style.display = 'block';
      if (pfpIcon) pfpIcon.style.display = 'none';
    }
  });
</script>
