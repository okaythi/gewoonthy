---
interface Props {
  current: 'home' | 'read' | 'about' | 'friends';
}
const { current } = Astro.props;
---

<nav id="mobile-tab-bar" class="mobile-tab-bar" role="tablist" aria-label="Main navigation">
  <a href="/" class={`tab-item${current === 'home' ? ' active' : ''}`} role="tab" aria-selected={current === 'home'} aria-label="Home">
    <span class="tab-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="5 3 19 12 5 21 5 3"/>
      </svg>
    </span>
    <span class="tab-label">Home</span>
  </a>
  <a href="/read" class={`tab-item${current === 'read' ? ' active' : ''}`} role="tab" aria-selected={current === 'read'} aria-label="Read">
    <span class="tab-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
      </svg>
    </span>
    <span class="tab-label">Read</span>
  </a>
  <a href="/about-me" class={`tab-item${current === 'about' ? ' active' : ''}`} role="tab" aria-selected={current === 'about'} aria-label="About">
    <span class="tab-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
    </span>
    <span class="tab-label">About</span>
  </a>
  <a href="/coolpeople" class={`tab-item${current === 'friends' ? ' active' : ''}`} role="tab" aria-selected={current === 'friends'} aria-label="Friends">
    <span class="tab-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
    </span>
    <span class="tab-label">Friends</span>
  </a>
</nav>

<style>
  .mobile-tab-bar {
    display: none;
  }

  @media (max-width: 767px) {
    .mobile-tab-bar {
      display: flex;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 500;
      background: rgba(8, 8, 8, 0.92);
      backdrop-filter: blur(28px) saturate(200%);
      -webkit-backdrop-filter: blur(28px) saturate(200%);
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      /* Safe area: home indicator bar (iPhone X+) + landscape notch */
      padding-bottom: env(safe-area-inset-bottom, 0px);
      padding-left: env(safe-area-inset-left, 0px);
      padding-right: env(safe-area-inset-right, 0px);
      /* GPU layer — prevents repaint during scroll */
      transform: translate3d(0, 0, 0);
      will-change: transform;
    }

    .tab-item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 10px 4px;
      color: #3a3a3a;
      text-decoration: none;
      gap: 4px;
      -webkit-tap-highlight-color: transparent;
      transition: color 0.2s ease;
      position: relative;
      /* box-sizing: border-box makes min-height the TOTAL height
         (including padding), so the tab bar renders at exactly 56px.
         Without this, content-box makes total = 56 + 10 + 10 = 76px,
         which is what was burying the track name under the bar. */
      box-sizing: border-box;
      min-height: 56px;
      /* Ensure tap target ≥ 44pt (Apple HIG) */
      min-width: 44px;
    }

    .tab-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .tab-item svg {
      width: 23px;
      height: 23px;
    }

    .tab-label {
      font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
      font-size: 0.58rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    /* Active state */
    .tab-item.active {
      color: #ffffff;
    }

    .tab-item.active .tab-icon {
      transform: translateY(-1px) scale(1.1);
    }

    /* Active indicator dot */
    .tab-item.active::before {
      content: '';
      position: absolute;
      top: 5px;
      left: 50%;
      transform: translateX(-50%);
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: #ffffff;
    }

    /* Touch feedback */
    .tab-item:active .tab-icon {
      transform: scale(0.88);
    }
  }
</style>

<style is:global>
  /* ============================================ */
  /* GLOBAL: Mobile page transition (slide-in)    */
  /* Uses View Transitions API via Astro's router */
  /* ============================================ */
  @media (max-width: 767px) {
    @keyframes mobile-slide-in {
      from { opacity: 0; transform: translateX(18px); }
      to   { opacity: 1; transform: translateX(0); }
    }
    @keyframes mobile-fade-out {
      from { opacity: 1; }
      to   { opacity: 0; }
    }

    ::view-transition-new(root) {
      animation: 320ms cubic-bezier(0.16, 1, 0.3, 1) both mobile-slide-in;
    }
    ::view-transition-old(root) {
      animation: 180ms ease both mobile-fade-out;
    }
  }

  /* ============================================ */
  /* GLOBAL: CSS variable for bottom clearance    */
  /* All pages use this for padding-bottom so     */
  /* content clears the tab bar + home indicator  */
  /* ============================================ */
  @media (max-width: 767px) {
    :root {
      /* Tab bar total height = 56px (border-box, includes 10px top/bottom padding).
         All pages use --mobile-bottom-pad for their padding-bottom clearance. */
      --tab-h: 56px;
      --mobile-bottom-pad: calc(var(--tab-h) + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
