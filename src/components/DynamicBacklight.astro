---
// DynamicBacklight.astro
---

<dynamic-backlight>
  <canvas class="backlight-canvas"></canvas>
</dynamic-backlight>

<style>
  dynamic-backlight {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible; /* we want the blur to bleed out */
    width: 100%;
    height: 100%;
  }

  .backlight-canvas {
    width: 100%;
    height: 100%;
    /* Keep the native aspect ratio roughly the same as the video */
    aspect-ratio: 16 / 9;
    /* Scale it slightly so the edges push out from under the video */
    transform: scale(1.0);
    /* Massive blur for diffusion, saturation boost for premium TV look */
    filter: blur(45px) saturate(180%) brightness(1.2);
    opacity: 0;
    transition: opacity 1s ease;
  }
  
  .backlight-canvas.active {
    opacity: 0.8;
  }
</style>

<script>
  class DynamicBacklight extends HTMLElement {
    constructor() {
      super();
      this.canvas = this.querySelector('.backlight-canvas');
      this.worker = null;
      this.animationId = null;
      this.video = null;
      
      this.tick = this.tick.bind(this);
      this.handlePlay = this.handlePlay.bind(this);
      this.handlePause = this.handlePause.bind(this);
    }

    connectedCallback() {
      // Find the video element in the DOM
      this.video = document.getElementById('anthem-video');
      
      if (!this.video) return;

      // Setup Worker
      this.worker = new Worker('/backlight-worker.js');
      
      // Setup OffscreenCanvas
      // Setting width/height to 64x64 for highly efficient downsampling
      this.canvas.width = 64;
      this.canvas.height = 64;
      
      const offscreen = this.canvas.transferControlToOffscreen();
      this.worker.postMessage({ type: 'INIT', canvas: offscreen }, [offscreen]);

      // Event listeners for Video
      this.video.addEventListener('play', this.handlePlay);
      this.video.addEventListener('pause', this.handlePause);
      this.video.addEventListener('ended', this.handlePause);
      
      // Astro ViewTransitions support for strict garbage collection
      document.addEventListener('astro:before-swap', this.teardown.bind(this), { once: true });
      window.addEventListener('beforeunload', this.teardown.bind(this), { once: true });
      
      if (!this.video.paused) {
        this.handlePlay();
      }
    }

    disconnectedCallback() {
      this.teardown();
    }

    teardown() {
      this.handlePause();
      if (this.worker) {
        this.worker.terminate();
        this.worker = null;
      }
      if (this.video) {
        this.video.removeEventListener('play', this.handlePlay);
        this.video.removeEventListener('pause', this.handlePause);
        this.video.removeEventListener('ended', this.handlePause);
      }
    }

    handlePlay() {
      this.canvas.classList.add('active');
      if (!this.animationId) {
        this.tick();
      }
    }

    handlePause() {
      this.canvas.classList.remove('active');
      if (this.animationId) {
        cancelAnimationFrame(this.animationId);
        this.animationId = null;
      }
    }

    async tick() {
      if (!this.video || this.video.paused || this.video.ended) {
        this.animationId = null;
        return;
      }

      // Check if video has valid dimensions
      if (this.video.videoWidth > 0 && this.video.videoHeight > 0) {
        try {
          // Efficiently capture the frame to an ImageBitmap without blocking main thread.
          // By defining resizeWidth/Height, the browser native code does the downsampling
          // before passing it to JS, making the worker message transfer infinitely lighter.
          const bitmap = await createImageBitmap(this.video, {
            resizeWidth: 64,
            resizeHeight: 64,
            resizeQuality: 'low'
          });
          
          if (this.worker) {
            this.worker.postMessage({ type: 'FRAME', frame: bitmap }, [bitmap]);
          } else {
            bitmap.close();
          }
        } catch (e) {
          // Ignore DOMException errors that might occur if video is not fully ready
        }
      }

      this.animationId = requestAnimationFrame(this.tick);
    }
  }

  // Register Custom Element
  if (!customElements.get('dynamic-backlight')) {
    customElements.define('dynamic-backlight', DynamicBacklight);
  }
</script>
