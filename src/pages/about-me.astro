---
import { ClientRouter } from 'astro:transitions';
import AntiCapture from '../components/AntiCapture.astro';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>About Me</title>
    <ClientRouter />
    <style is:global>
      :root {
        --bg: #050505;
        --fg: #f0f0f0;
        --accent: #a3a3a3;
        --border: rgba(255, 255, 255, 0.08);
        --glass-bg: rgba(255, 255, 255, 0.02);
        --glass-hover: rgba(255, 255, 255, 0.04);
      }
      body {
        margin: 0; padding: 0; background: var(--bg); color: var(--fg);
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
        min-height: 100dvh;
        padding-top: env(safe-area-inset-top, 20px);
        padding-bottom: env(safe-area-inset-bottom, 20px);
        padding-left: env(safe-area-inset-left, 20px);
        padding-right: env(safe-area-inset-right, 20px);
        overflow-x: hidden;
      }
      .container {
        max-width: 900px;
        margin: 0 auto;
        padding: clamp(2rem, 5vw, 6rem) clamp(1rem, 3vw, 2rem);
      }
      /* Hardware accelerated nav */
      .nav {
        position: fixed;
        top: 0; left: 0; width: 100%;
        padding: clamp(1rem, 3vw, 1.5rem) clamp(1rem, 3vw, 2rem);
        background: rgba(5, 5, 5, 0.6);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        transform: translate3d(0,0,0);
        z-index: 50;
        display: flex; justify-content: flex-start;
      }
      .back-btn {
        color: var(--accent); text-decoration: none;
        display: flex; align-items: center; gap: 8px;
        font-weight: 500; font-size: 0.95rem;
        transition: color 0.3s ease;
        -webkit-tap-highlight-color: transparent;
      }
      .back-btn:hover { color: var(--fg); }
      .back-btn svg { width: 20px; height: 20px; transition: transform 0.3s ease; }
      .back-btn:hover svg { transform: translateX(-4px); }
      
      .pfp-container {
        display: flex; justify-content: center; margin-bottom: 4rem;
        position: relative;
      }
      .pfp-container::before {
        content: '';
        position: absolute;
        top: 50%; left: 50%;
        width: 140px; height: 140px;
        transform: translate(-50%, -50%);
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        border-radius: 50%;
        z-index: -1;
      }
      .pfp {
        width: clamp(100px, 15vw, 130px);
        height: clamp(100px, 15vw, 130px);
        border-radius: 50%;
        object-fit: cover;
        background-color: #111;
        border: 1px solid var(--border);
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;
      }
      .pfp:hover {
        transform: scale(1.05) translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.6), 0 0 20px rgba(255,255,255,0.05);
      }
      
      #blocks-root {
        display: flex;
        flex-direction: column;
        gap: clamp(3rem, 6vw, 5rem);
      }
      
      /* Block styling */
      .block {
        opacity: 0; transform: translateY(30px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .block.visible { opacity: 1; transform: translateY(0); }
      
      .category-title {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--accent);
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .category-title::after {
        content: "";
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, var(--border) 0%, transparent 100%);
      }
      
      /* Sleek Grid */
      .fields-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.25rem;
      }
      
      /* Full width for Bio or long text */
      .fields-grid:has(.field-card.is-bio) {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }
      
      .field-card {
        background: var(--glass-bg);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        position: relative;
        overflow: hidden;
      }
      .field-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: radial-gradient(circle at top left, rgba(255,255,255,0.03), transparent 70%);
        opacity: 0;
        transition: opacity 0.4s ease;
      }
      .field-card:hover {
        background: var(--glass-hover);
        border-color: rgba(255,255,255,0.15);
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
      }
      .field-card:hover::before {
        opacity: 1;
      }
      
      .field-label {
        font-weight: 600;
        color: var(--accent);
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        position: relative;
        z-index: 1;
      }
      
      .field-value {
        font-size: 1.1rem;
        line-height: 1.6;
        color: #e2e2e2;
        white-space: pre-wrap;
        font-weight: 300;
        position: relative;
        z-index: 1;
      }
      
      .empty-state {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        min-height: 40vh;
        text-align: center;
        font-style: italic;
        color: var(--accent);
        font-size: 1.2rem;
        font-weight: 300;
      }
      
      @media (pointer: coarse) {
        .back-btn { padding: 12px; }
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/" class="back-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back
      </a>
    </nav>
    <main class="container" id="content-root">
      <div class="pfp-container">
        <img id="about-pfp" src="/media/about_me_pfp.png" class="pfp" alt="thy" onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'%23333\' stroke=\'%23888\' stroke-width=\'1\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><circle cx=\'12\' cy=\'8\' r=\'5\'/><path d=\'M20 21a8 8 0 0 0-16 0\'/></svg>'">
      </div>
      <div id="blocks-root">
        <div class="empty-state">Loading...</div>
      </div>
    </main>
    
    <AntiCapture />

    <script src="/scripts/about-me.js" is:inline></script>
  </body>
</html>
