---
import { ClientRouter } from 'astro:transitions';
import AntiCapture from '../components/AntiCapture.astro';
import MobileNav from '../components/MobileNav.astro';
import AuthButton from '../components/AuthButton.astro';
import LoginModal from '../components/LoginModal.astro';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>Read - Thy</title>
    <ClientRouter />
    <!-- Cloudflare Web Analytics --><script defer async src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "ad29414c138e4d91a3f01c8b348f91a1"}'></script><!-- End Cloudflare Web Analytics -->
    <style>
      body { margin: 0; padding: 4dvh 4vw; background-color: #000000; color: #d9d9d9; font-family: ui-sans-serif, system-ui, -apple-system, sans-serif; display: flex; flex-direction: column; height: 100dvh; box-sizing: border-box; overflow: hidden; user-select: none; }
      .top-bar { flex: 0 0 auto; display: flex; justify-content: space-between; align-items: center; z-index: 100; }
      /* Desktop Navigation */
      .left-nav { position: fixed; bottom: max(4vh, 30px); left: 4vw; z-index: 100; display: flex; align-items: center; gap: 15px; }
      .nav-link { display: flex; align-items: center; justify-content: center; color: #444; text-decoration: none; transition: color 0.2s ease, transform 0.2s ease; -webkit-tap-highlight-color: transparent; }
      .nav-link:hover { color: #ffffff; transform: scale(1.05); }
      .nav-link svg { width: 28px; height: 28px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
      .lang-selector { background: transparent; border: none; color: #7a7a7a; font-family: inherit; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; outline: none; transition: color 0.2s ease; appearance: none; padding-right: 10px; }
      .lang-selector:hover, .lang-selector:focus { color: #ffffff; }
      .lang-selector option { background: #111; color: #fff; }
      .content-wrapper { flex: 1 1 auto; display: flex; flex-direction: column; justify-content: center; align-items: center; max-width: 800px; margin: 0 auto; width: 100%; text-align: center; }
      .status-text { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 2px; color: #444; margin-bottom: 3rem; }
      .quote-container { opacity: 0; transform: translateY(10px); transition: opacity 1s ease, transform 1s ease; }
      .quote-container.visible { opacity: 1; transform: translateY(0); }
      blockquote { margin: 0; font-weight: 300; color: #ffffff; font-size: clamp(1.2rem, 3vw, 1.8rem); line-height: 1.6; font-style: italic; user-select: text; cursor: text; }
      blockquote::selection { background: rgba(255,255,255,0.2); color: #fff; }
      .author { margin-top: 1.5rem; font-size: 0.9rem; color: #7a7a7a; letter-spacing: 1px; }
      .source { font-size: 0.75rem; color: #444; margin-top: 0.25rem; text-transform: uppercase; letter-spacing: 0.5px; }
      .consent-toast { position: fixed; bottom: 3dvh; left: 50%; transform: translateX(-50%) translateY(150%); background: rgba(10, 10, 10, 0.7); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 50px; padding: 0.6rem 1.5rem; display: flex; align-items: center; gap: 1.5rem; font-size: 0.75rem; color: #7a7a7a; white-space: nowrap; z-index: 1000; transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8); }
      .consent-toast.visible { transform: translateX(-50%) translateY(0); }
      .privacy-link { color: #aaaaaa; text-decoration: underline; transition: color 0.2s ease; }
      .privacy-link:hover { color: #ffffff; }
      .consent-actions { display: flex; gap: 1rem; }
      .consent-actions button { background: transparent; border: none; color: #d9d9d9; cursor: pointer; font-family: inherit; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; padding: 0; transition: color 0.2s ease; }
      .consent-actions button:hover { color: #ffffff; }
      @media (max-width: 768px) { .consent-toast { width: 90vw; border-radius: 12px; flex-direction: column; gap: 0.75rem; text-align: center; white-space: normal; padding: 1rem; bottom: calc(2dvh + env(safe-area-inset-bottom)); } }

      /* ===== MOBILE-NATIVE ===== */
      @media (max-width: 767px) {
        body {
          /* Respect top notch/Dynamic Island */
          padding: env(safe-area-inset-top, 4dvh) env(safe-area-inset-right, 4vw) 0 env(safe-area-inset-left, 4vw);
          /* Clear tab bar + home indicator at bottom */
          padding-bottom: calc(var(--mobile-bottom-pad, 72px) + 2dvh);
        }
        /* Nav hidden — tab bar handles navigation */
        .left-nav { display: none !important; }
        /* Lang picker becomes a subtle floating chip top-right */
        .top-bar {
          justify-content: flex-end;
        }
        /* Consent toast clears tab bar */
        .consent-toast {
          bottom: calc(70px + env(safe-area-inset-bottom, 0px)) !important;
          z-index: 10000;
        }
        /* Quote slightly larger on phones */
        blockquote {
          font-size: clamp(1.3rem, 5vw, 1.8rem);
        }
      }
    </style>
  </head>
  <body>
    <div class="left-nav">
       <a href="/songs" class="nav-link" aria-label="Listen" title="Listen"><svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg></a>
       <a href="/" class="nav-link" aria-label="About Me" title="About Me"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></a>
       <a href="/coolpeople" class="nav-link" aria-label="Cool People" title="Cool People"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></a>
    </div>
    <div class="top-bar" style="justify-content: flex-end;">
      <select id="lang-picker" class="lang-selector"><option value="en">EN</option><option value="nl">NL</option><option value="fr">FR</option></select>
    </div>
    <div class="content-wrapper">
      <div class="status-text">You must be verified to have access to the book(s).</div>
      <div id="quote-box" class="quote-container">
        <blockquote id="quote-text">Loading...</blockquote>
        <div id="quote-author" class="author"></div>
        <div id="quote-source" class="source"></div>
      </div>
    </div>
    <AntiCapture />
    <div id="consent-toast" class="consent-toast">
      <span>Looks like you're in the EU. I use local storage to remember which quotes you've seen. You can <a href="/privacy" class="privacy-link">read what data I collect and how it is used</a>.</span>
      <div class="consent-actions"><button id="consent-accept">Accept</button><button id="consent-decline">Decline</button></div>
    </div>
    <script src="/scripts/read.js" is:inline></script>
    <script>
      import { supabase } from '../lib/supabase.js';
      document.addEventListener('astro:page-load', async () => {
        const { data: { session } } = await supabase.auth.getSession();
        if (session) {
          const statusText = document.querySelector('.status-text');
          if (statusText) statusText.textContent = 'Book currently unavailable';
        }
      });
    </script>
    <AuthButton />
    <LoginModal />
    <MobileNav current="read" />
  </body>
</html>
