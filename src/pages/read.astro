---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Read - Thy</title>
    <style>
      body {
        margin: 0;
        padding: 4dvh 4vw;
        background-color: #000000;
        color: #d9d9d9;
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }
      .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #7a7a7a;
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.2s ease;
      }
      .back-btn:hover {
        color: #ffffff;
      }
      .back-btn svg {
        width: 16px;
        height: 16px;
        stroke: currentColor;
        stroke-width: 2;
        fill: none;
      }
      .content {
        margin-top: 8vh;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
      }
      h1 {
        font-weight: 300;
        color: #ffffff;
        font-style: italic;
      }
    </style>
  </head>
  <body>
    <a href="/" class="back-btn">
      <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      Return
    </a>
    <div class="content">
      <h1>Standing by for transmission...</h1>
    </div>
  </body>
</html>
