---
import { ClientRouter } from 'astro:transitions';
import AntiCapture from '../components/AntiCapture.astro';
import MobileNav from '../components/MobileNav.astro';
import AuthButton from '../components/AuthButton.astro';
import LoginModal from '../components/LoginModal.astro';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Cool People</title>
    <ClientRouter />
    <style is:global>
      :root {
        --bg: #000000;
        --fg: #f0f0f0;
        --accent: #a3a3a3;
      }
      body {
        margin: 0; padding: 0; background: var(--bg); color: var(--fg);
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
        min-height: 100dvh;
        overflow-x: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      /* Desktop Navigation */
      .left-nav { position: fixed; bottom: max(4vh, 30px); left: 4vw; z-index: 100; display: flex; align-items: center; gap: 15px; }
      .nav-link { display: flex; align-items: center; justify-content: center; color: #444; text-decoration: none; transition: color 0.2s ease, transform 0.2s ease; -webkit-tap-highlight-color: transparent; }
      .nav-link:hover { color: #ffffff; transform: scale(1.05); }
      .nav-link svg { width: 28px; height: 28px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
      

      

      /* ===== MOBILE-NATIVE: compact grid ===== */
      @media (max-width: 767px) {
        /* Nav hidden — tab bar handles navigation */
        .left-nav { display: none !important; }

        body {
          align-items: flex-start;
          justify-content: flex-start;
          min-height: 100dvh;
          overflow-x: hidden;
          overflow-y: auto;
        }

        main {
          width: 100%;
          /* Reserve space for tab bar + safe area at bottom */
          padding-bottom: calc(var(--mobile-bottom-pad, calc(56px + env(safe-area-inset-bottom, 0px))) + 1rem);
          padding-top: env(safe-area-inset-top, 1rem);
          box-sizing: border-box;
        }
      }
    </style>

    <style is:global>
      /* DESKTOP STYLES (Dynamic elements) */
      .friends-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 3rem 4rem;
        max-width: 850px;
        margin: 0 auto;
        align-items: flex-start;
        padding: 2rem;
      }
      @media (max-width: 900px) {
        .friends-grid { gap: 2rem 3rem; }
      }
      .friend-card {
        width: 160px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1rem;
        opacity: 0;
        animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .friend-avatar {
        width: clamp(100px, 15vw, 140px);
        height: clamp(100px, 15vw, 140px);
        border-radius: 50%;
        object-fit: cover;
        background-color: #111;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
      }
      .friend-card:hover .friend-avatar {
        transform: scale(1.05) translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.6), 0 0 20px rgba(255,255,255,0.05);
      }
      .friend-username {
        font-size: 1.2rem;
        font-weight: 500;
        letter-spacing: 0.5px;
        color: #e2e2e2;
      }
      .badges-container {
        display: flex;
        gap: 8px;
        justify-content: center;
        align-items: center;
        margin-top: -6px;
        flex-wrap: wrap;
      }
      .badge-icon {
        width: 24px;
        height: 24px;
        object-fit: contain;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
        transition: transform 0.2s ease;
      }
      .badge-icon:hover {
        transform: translateY(-2px) scale(1.1);
      }

      /* MOBILE OVERRIDES */
      @media (max-width: 767px) {
        .friends-grid {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 2rem 1.5rem;
          padding: 1.5rem;
          max-width: 100%;
          margin: 0;
          justify-items: center;
        }

        .friend-card {
          width: 100%;
          max-width: 130px;
        }

        .friend-avatar {
          width: 90px;
          height: 90px;
        }

        .friend-username {
          font-size: 0.9rem;
          font-weight: 600;
        }

        .badge-icon {
          width: 20px;
          height: 20px;
        }
      }
    </style>
  </head>
  <body>
    <div class="left-nav">
       <a href="/read" class="nav-link" aria-label="Read" title="Read"><svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg></a>
       <a href="/songs" class="nav-link" aria-label="Listen" title="Listen"><svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg></a>
       <a href="/" class="nav-link" aria-label="About Me" title="About Me"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></a>
    </div>
    <main>
      <div id="friends-grid" class="friends-grid"></div>
    </main>
    
    <AntiCapture />
    <AuthButton />
    <LoginModal />
    <MobileNav current="friends" />
  </body>
</html>
