---
import { ClientRouter } from 'astro:transitions';
import AntiCapture from '../components/AntiCapture.astro';
import MobileNav from '../components/MobileNav.astro';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Cool People</title>
    <ClientRouter />
    <style is:global>
      :root {
        --bg: #000000;
        --fg: #f0f0f0;
        --accent: #a3a3a3;
      }
      body {
        margin: 0; padding: 0; background: var(--bg); color: var(--fg);
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
        min-height: 100dvh;
        overflow-x: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      /* Hardware accelerated nav */
      .nav {
        position: fixed;
        top: 0; left: 0; width: 100%;
        padding: clamp(1rem, 3vw, 1.5rem) clamp(1rem, 3vw, 2rem);
        background: transparent;
        transform: translate3d(0,0,0);
        z-index: 50;
        display: flex; justify-content: flex-start;
      }
      .back-btn {
        color: var(--accent); text-decoration: none;
        display: flex; align-items: center; gap: 8px;
        font-weight: 500; font-size: 0.95rem;
        transition: color 0.3s ease;
        -webkit-tap-highlight-color: transparent;
      }
      .back-btn:hover { color: var(--fg); }
      .back-btn svg { width: 20px; height: 20px; transition: transform 0.3s ease; }
      .back-btn:hover svg { transform: translateX(-4px); }
      
      .friends-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 3rem 4rem;
        max-width: 850px;
        margin: 0 auto;
        align-items: flex-start;
        padding: 2rem;
      }
      @media (max-width: 900px) {
        .friends-grid { gap: 2rem 3rem; }
      }
      .friend-card {
        width: 160px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1rem;
        opacity: 0;
        animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .friend-avatar {
        width: clamp(100px, 15vw, 140px);
        height: clamp(100px, 15vw, 140px);
        border-radius: 50%;
        object-fit: cover;
        background-color: #111;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
      }
      .friend-card:hover .friend-avatar {
        transform: scale(1.05) translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.6), 0 0 20px rgba(255,255,255,0.05);
      }
      .friend-username {
        font-size: 1.2rem;
        font-weight: 500;
        letter-spacing: 0.5px;
        color: #e2e2e2;
      }
      .badges-container {
        display: flex;
        gap: 8px;
        justify-content: center;
        align-items: center;
        margin-top: -6px;
        flex-wrap: wrap;
      }
      .badge-icon {
        width: 24px;
        height: 24px;
        object-fit: contain;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
        transition: transform 0.2s ease;
      }
      .badge-icon:hover {
        transform: translateY(-2px) scale(1.1);
      }
      
      @media (pointer: coarse) {
        .back-btn { padding: 12px; }
      }

      /* ===== MOBILE-NATIVE: compact grid ===== */
      @media (max-width: 767px) {
        /* Nav hidden — tab bar handles navigation */
        .nav { display: none !important; }

        body {
          align-items: flex-start;
          justify-content: flex-start;
          min-height: 100dvh;
          overflow-x: hidden;
          overflow-y: auto;
        }

        main {
          width: 100%;
          /* Reserve space for tab bar + safe area at bottom */
          padding-bottom: calc(var(--mobile-bottom-pad, calc(56px + env(safe-area-inset-bottom, 0px))) + 1rem);
          padding-top: env(safe-area-inset-top, 1rem);
          box-sizing: border-box;
        }

    <style is:global>
      /* 2-column grid on phones */
      .friends-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem 1.5rem;
        padding: 1.5rem;
        max-width: 100%;
        margin: 0;
        justify-items: center;
      }

      .friend-card {
        width: 100%;
        max-width: 130px;
      }

      .friend-avatar {
        width: 90px;
        height: 90px;
      }

      .friend-username {
        font-size: 0.9rem;
        font-weight: 600;
      }

      .badge-icon {
        width: 20px;
        height: 20px;
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/" class="back-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back
      </a>
    </nav>
    <main>
      <div id="friends-grid" class="friends-grid"></div>
    </main>
    
    <AntiCapture />
    <MobileNav current="friends" />
  </body>
</html>
