---
import Layout from '../layouts/Layout.astro';
import { Content as AboutKaraokeContent } from '../data/about-karaoke.md';
---

<Layout title="> sudothy">
	<template id="about-karaoke-template">
		<div class="ubuntu-prose">
			<AboutKaraokeContent />
		</div>
	</template>
	<div id="terminal-container">
		<div id="terminal-output"></div>
		<div id="terminal-input-wrapper" style="display: none;">
			<div class="terminal-input-line">
				<span id="prompt-prefix" class="terminal-prompt"></span><span id="prompt-path" class="terminal-prompt-path"></span><span id="prompt-char" style="margin-right: 8px; color: var(--ubuntu-text);">$</span>
				<span id="input-display"></span><span class="cursor"></span>
			</div>
		</div>
	</div>
	<input type="text" id="hidden-input" autocomplete="off" spellcheck="false" autocorrect="off" autocapitalize="off" />
	<script src="../lib/Terminal.js"></script>
</Layout>
