---
const pageTitle = "I'm cooking something here...";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <link rel="icon" type="image/png" href="https://sudothy.me/media/vanity/pentagram.png" />
  <link rel="apple-touch-icon" href="https://sudothy.me/media/vanity/pentagram.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #000000;
      --fg: #ffffff;
      --fg-dim: rgba(255, 255, 255, 0.6);
    }
    
    html, body {
      margin: 0;
      padding: 0;
      width: 100vw;
      height: 100dvh;
      background-color: var(--bg);
      color: var(--fg);
      overflow: hidden;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      /* Anti-copy measures */
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      user-select: none;
      -webkit-user-drag: none;
    }

    .container {
      display: flex;
      flex-direction: column;
      height: 100%;
      padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
      box-sizing: border-box;
    }

    .header {
      text-align: center;
      padding: 4rem 1rem 1rem 1rem;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    h1 {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(1.32rem, 3.77vw, 2.07rem);
      margin: 0;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-shadow: 0 2px 10px rgba(255,0,0,0.15);
    }

    .subtitle {
      color: var(--fg-dim);
      font-size: 0.95rem;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-weight: 400;
      letter-spacing: 0.02em;
      margin: 0;
    }

    .video-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 1rem;
      min-height: 0;
      width: 100%;
      box-sizing: border-box;
    }

    .video-container {
      position: relative;
      width: 100%;
      height: 100%;
      max-width: 900px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 0;
      min-width: 0;
    }

    .player-stack {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: fit-content;
      height: 100%;
      max-width: 100%;
      min-height: 0;
      min-width: 0;
    }

    .custom-player-wrapper {
      position: relative;
      width: auto;
      height: auto;
      aspect-ratio: 16 / 9;
      max-width: 100%;
      max-height: calc(100dvh - 280px);
      box-shadow: 0 4px 30px rgba(255,255,255,0.05);
      border-radius: 8px;
      background-color: #050505;
      overflow: hidden;
      display: flex;
    }

    .custom-player-wrapper video {
      width: 100%;
      height: 100%;
      object-fit: contain;
      outline: none;
      cursor: pointer;
    }

    :global(.lyrics-container) {
      position: relative;
      flex: 1;
      display: grid;
      grid-template-areas: "verse";
      place-items: center;
      text-align: center;
      font-size: clamp(0.9rem, 1.5vw, 1.15rem);
      font-weight: 700;
    }


    :global(.verse) {
      grid-area: verse;
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
      width: 100%;
    }

    :global(.verse.active) {
      opacity: 1;
    }

    :global(.word) {
      display: inline-block;
      white-space: pre-wrap;
      margin-right: 0.25em;
      transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), text-shadow 0.2s, -webkit-text-stroke 0.2s, color 0.2s;
      will-change: transform;
      color: rgba(255, 255, 255, 0.3);
    }

    :global(.word.active) {
      transform: scale(1.15) !important;
      color: #fff !important;
      text-shadow: 0 0 12px rgba(255, 255, 255, 0.8) !important;
      -webkit-text-stroke: 1px rgba(255,255,255,0.2) !important;
    }

    :global(.unmute-overlay) {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 20;
      cursor: pointer;
    }
    
    :global(.unmute-btn) {
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.3);
      padding: 12px 24px;
      border-radius: 30px;
      font-size: 1.1rem;
      font-weight: 600;
      backdrop-filter: blur(4px);
      transition: background 0.2s, transform 0.1s;
    }
    
    :global(.unmute-overlay:hover .unmute-btn) {
      background: rgba(255, 255, 255, 0.25);
    }
    
    :global(.unmute-overlay:active .unmute-btn) {
      transform: scale(0.95);
    }

    .custom-controls {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(transparent, rgba(0,0,0,0.85) 40%, #000);
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 24px 16px 12px 16px;
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 10;
      overflow: hidden;
    }

    .custom-player-wrapper:hover .custom-controls,
    .custom-player-wrapper.interacting .custom-controls {
      opacity: 1;
    }

    .custom-controls button {
      background: none;
      border: none;
      color: #fff;
      cursor: pointer;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0.8;
      transition: opacity 0.2s, transform 0.1s;
    }

    .custom-controls button:hover {
      opacity: 1;
    }

    .custom-controls button:active {
      transform: scale(0.9);
    }

    .custom-controls svg {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    
    #cc-play svg {
      fill: currentColor;
      stroke: none;
    }

    .cc-time {
      font-size: 0.8rem;
      font-variant-numeric: tabular-nums;
      color: #ccc;
      white-space: nowrap;
    }

    .cc-progress-container, .cc-volume-container {
      position: relative;
      display: flex;
      align-items: center;
    }

    .cc-progress-container {
      flex: 1;
    }
    
    .cc-volume-container {
      width: 60px;
    }

    input[type=range] {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      background: transparent;
      cursor: pointer;
      height: 24px;
      margin: 0;
    }
    
    input[type=range]::-webkit-slider-runnable-track {
      width: 100%;
      height: 4px;
      background: linear-gradient(to right, #fff var(--val, 0%), rgba(255,255,255,0.2) var(--val, 0%));
      border-radius: 2px;
    }
    
    input[type=range]::-moz-range-track {
      width: 100%;
      height: 4px;
      background: linear-gradient(to right, #fff var(--val, 0%), rgba(255,255,255,0.2) var(--val, 0%));
      border-radius: 2px;
    }

    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      height: 12px;
      width: 12px;
      border-radius: 50%;
      background: #fff;
      margin-top: -4px;
      box-shadow: 0 0 5px rgba(0,0,0,0.5);
    }
    
    input[type=range]::-moz-range-thumb {
      height: 12px;
      width: 12px;
      border-radius: 50%;
      background: #fff;
      border: none;
      box-shadow: 0 0 5px rgba(0,0,0,0.5);
    }
    
    @media (max-width: 600px) {
      .cc-time, .cc-volume-container, #cc-mute {
        display: none !important;
      }
    }

    @media (pointer: coarse) {
      .custom-controls {
        display: none !important;
      }
    }

    .footer {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.5rem 1rem;
    }

    .contact-module {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 6px 6px 6px 10px;
      background: rgba(255, 255, 255, 0.04);
      border-radius: 32px;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .contact-module-divider {
      width: 1px;
      height: 18px;
      background: rgba(255, 255, 255, 0.15);
    }

    .contact-line {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1rem;
      color: var(--fg);
      font-weight: 500;
      letter-spacing: 0.01em;
    }

    .pfp-mini-container {
      position: relative;
      width: 32px;
      height: 32px;
    }

    .pfp-mini-container img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      pointer-events: none;
    }

    .status-dot {
      position: absolute;
      bottom: -1px;
      right: -1px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background-color: #80848e;
      border: 2px solid #1a1a1a;
    }

    .github-link {
      color: var(--fg);
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
      transition: background 0.2s, transform 0.1s;
      text-decoration: none;
    }

    .github-link:hover {
      background: rgba(255, 255, 255, 0.15);
    }

    .github-link:active {
      transform: scale(0.95);
    }

    .github-link svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }

    .player-bottom-row {
      display: grid;
      grid-template-columns: 140px 1fr 140px;
      align-items: center;
      width: 100%;
      min-height: 48px;
      margin-top: 12px;
      z-index: 5;
    }
    
    @media (max-width: 768px) {
      .player-bottom-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
      }
      .lyrics-container {
        order: 3;
        flex: none;
        width: 100%;
        margin-top: 16px;
      }
      .left-controls { order: 1; }
      .vote-controls { order: 2; }
    }

    .left-controls {
      display: flex;
      justify-content: flex-start;
      margin-left: 16px;
      z-index: 10;
    }

    .shuffle-btn {
      background: none;
      border: none;
      padding: 8px 12px;
      border-radius: 20px;
      cursor: pointer;
      color: var(--fg-dim);
      transition: color 0.2s, background-color 0.2s, transform 0.1s;
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      font-family: inherit;
    }

    .shuffle-btn:hover {
      color: var(--fg);
      background-color: rgba(255, 255, 255, 0.1);
    }

    .shuffle-btn:active {
      transform: scale(0.95);
    }

    .shuffle-btn svg {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .vote-controls {
      display: flex;
      gap: 16px;
      justify-content: flex-end;
      margin-right: 16px;
      z-index: 10;
    }

    .vote-btn {
      background: none;
      border: none;
      padding: 8px;
      border-radius: 50%;
      cursor: pointer;
      color: var(--fg-dim);
      transition: color 0.2s, transform 0.1s;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .vote-btn:hover {
      color: var(--fg);
      background-color: rgba(255, 255, 255, 0.1);
    }

    .vote-btn:active {
      transform: scale(0.9);
    }

    .vote-btn svg {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .vote-btn.active svg {
      fill: currentColor;
    }
  </style>
  <style is:global>
    .gab-side {
      display: none;
    }
    
    @media (min-width: 1024px) {
      .viz-canvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        pointer-events: none;
      }
      
      .gab-side {
        display: flex;
        flex: 1;
        height: 100%;
        position: relative;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        container-type: inline-size;
      }
      .gab-side-word {
        position: absolute;
        width: 100%;
        left: 0;
        font-weight: 900;
        text-transform: uppercase;
        color: #fff;
        text-align: center;
        pointer-events: none;
        white-space: nowrap;
        animation: bamIn 0.15s cubic-bezier(0.17, 0.89, 0.32, 1.28) forwards;
        
        text-shadow: 
          0 0 10px #ff0018,
          0 0 20px #ffa52c,
          0 0 30px #ffff41,
          0 0 40px #008018,
          0 0 50px #0000f9,
          0 0 60px #86007d;
      }
      .gab-side-word.fade-out {
        animation: bamOut 0.6s ease forwards;
      }
      @keyframes bamIn {
        from { transform: scale(0.2) rotate(-5deg); opacity: 0; }
        to { transform: scale(1) rotate(0deg); opacity: 1; }
      }
      @keyframes bamOut {
        from { transform: scale(1); opacity: 1; }
        to { transform: scale(0.8); opacity: 0; }
      }
    }
  </style>
</head>
<body oncontextmenu="return false;">
  
  <div class="container">
    <div class="header">
      <h1>{pageTitle}</h1>
      <p class="subtitle" id="anthem-subtitle">In the meantime, here's a good anthem:</p>
    </div>

    <div class="video-wrapper">
      <div id="gab-side-left" class="gab-side"><canvas id="viz-left" class="viz-canvas"></canvas></div>
      <div class="video-container">
        <div class="player-stack">
          <div class="custom-player-wrapper" id="player-wrapper">
            <div id="unmute-overlay" class="unmute-overlay" style="display: none;">
              <button class="unmute-btn">Click to unmute</button>
            </div>
            <video 
              id="anthem-video"
              src=""
              controls 
              crossorigin="anonymous"
              controlsList="nodownload noremoteplayback noplaybackrate"
              disablePictureInPicture
              playsinline
              preload="auto"
              autoplay
            >
            </video>
            <div class="custom-controls" id="custom-controls">
              <button id="cc-play" title="Play/Pause">
                <svg viewBox="0 0 24 24" id="icon-play"><path d="M5 3l14 9-14 9v-18z"></path></svg>
              </button>
              <div class="cc-progress-container">
                <input type="range" id="cc-progress" min="0" max="100" value="0" step="0.1" style="--val: 0%">
              </div>
              <div class="cc-time" id="cc-time">0:00 / 0:00</div>
              <button id="cc-mute" title="Mute/Unmute">
                <svg viewBox="0 0 24 24" id="icon-vol"><path d="M11 5L6 9H2v6h4l5 4V5zM15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
              </button>
              <div class="cc-volume-container">
                <input type="range" id="cc-volume" min="0" max="1" step="0.01" value="0.35" style="--val: 35%">
              </div>
              <button id="cc-fullscreen" title="Fullscreen">
                <svg viewBox="0 0 24 24"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
              </button>
            </div>
          </div>
          <div class="player-bottom-row">
            <div class="left-controls">
              <button id="btn-shuffle" class="shuffle-btn" title="Shuffle song">
                <svg viewBox="0 0 24 24"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"></path></svg>
                <span>Shuffle song</span>
              </button>
            </div>
            <div class="lyrics-container" id="lyrics-container"></div>
            <div class="vote-controls">
              <button id="btn-like" class="vote-btn" title="Like">
                <svg viewBox="0 0 24 24"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path></svg>
              </button>
              <button id="btn-dislike" class="vote-btn" title="Dislike">
                <svg viewBox="0 0 24 24"><path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h2a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-2"></path></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
      <div id="gab-side-right" class="gab-side"><canvas id="viz-right" class="viz-canvas"></canvas></div>
    </div>

    <div class="footer">
      <div class="contact-module">
        <div class="contact-line">
          <div class="pfp-mini-container">
            <img id="mini-pfp" src="/api/pfp" alt="PFP" />
            <div id="mini-status" class="status-dot"></div>
          </div>
          <span><span style="opacity: 0.6">Discord:</span> <span id="discord-username">okaythi</span></span>
        </div>
        <div class="contact-module-divider"></div>
        <a href="https://github.com/okaythi" class="github-link" target="_blank" rel="noopener noreferrer" title="GitHub">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <script>
    import { songsDictionary } from '../data/lyrics.ts';
    document.addEventListener('DOMContentLoaded', async () => {
      // 1. Fetch live presence
      const pfp = document.getElementById('mini-pfp');
      const stat = document.getElementById('mini-status');
      const usernameSpan = document.getElementById('discord-username');
      const colors = { online: '#23a559', idle: '#f0b232', dnd: '#f23f43', offline: '#80848e' };
      
      const updatePresence = async () => {
        try {
          const res = await fetch('https://gewoonthy.onrender.com/api/me', { cache: 'no-store' });
          if (res.ok) {
              const data = await res.json();
              if (data.avatar_url && pfp) pfp.src = data.avatar_url;
              if (data.status && stat) stat.style.backgroundColor = colors[data.status] || colors.offline;
              if (data.username && usernameSpan) usernameSpan.textContent = data.username;
          }
        } catch (e) {}
      };
      
      await updatePresence();
      setInterval(updatePresence, 15000);

      // Randomize Video Logic
      const availableVideos = Object.keys(songsDictionary);
      let playedVideos = [];
      let isNewVisitor = true;
      try {
        const stored = localStorage.getItem('playedVideos');
        if (stored) {
            playedVideos = JSON.parse(stored);
            if (playedVideos.length > 0) isNewVisitor = false;
        }
      } catch (e) {}

      // Filter out played videos
      let remaining = availableVideos.filter(v => !playedVideos.includes(v));

      if (remaining.length === 0) {
        const lastPlayed = playedVideos[playedVideos.length - 1];
        playedVideos = [lastPlayed];
        remaining = availableVideos.filter(v => v !== lastPlayed);
      }

      // Check for bleeding-edge URL param (?v=...)
      const urlParams = new URLSearchParams(window.location.search);
      const requestedSlug = urlParams.get('v');
      
      let selectedVideo;
      if (requestedSlug) {
        const match = availableVideos.find(v => v.toLowerCase().includes(requestedSlug.toLowerCase()));
        if (match) selectedVideo = match;
      }

      // Pick random or force Gabrielle for new visitors
      if (!selectedVideo) {
        if (isNewVisitor && availableVideos.includes('Gabrielle - 5 fine frøkner.mp4')) {
          selectedVideo = 'Gabrielle - 5 fine frøkner.mp4';
        } else {
          selectedVideo = remaining[Math.floor(Math.random() * remaining.length)];
        }
      }
      
      playedVideos.push(selectedVideo);
      localStorage.setItem('playedVideos', JSON.stringify(playedVideos));

      // Setup data
      let songData = songsDictionary[selectedVideo];
      let lyricsData = songData.lyricsData;
      let GLOBAL_OFFSET = songData.globalOffset || 0;
      let subtitle = songData.subtitle || 'In the meantime, check out this banger:';
      
      const subtitleEl = document.getElementById('anthem-subtitle');
      if (subtitleEl) subtitleEl.textContent = subtitle;

      // 2. Setup video player
      let vid = document.getElementById('anthem-video');
      const wrapper = document.getElementById('player-wrapper');
      const lyricsContainer = document.getElementById('lyrics-container');

      if (vid) {
        vid.addEventListener('loadedmetadata', () => {
          const wrapper = document.getElementById('player-wrapper');
          if (wrapper && vid.videoWidth && vid.videoHeight) {
            wrapper.style.aspectRatio = `${vid.videoWidth} / ${vid.videoHeight}`;
            vid.style.objectFit = 'contain';
          }
        });
      }

      const unmuteOverlay = document.getElementById('unmute-overlay');
      if (unmuteOverlay) {
        unmuteOverlay.addEventListener('click', (e) => {
          e.stopPropagation();
          if (vid) {
            vid.muted = false;
            vid.volume = 0.35;
          }
          unmuteOverlay.style.display = 'none';
          
          const volIcon = document.getElementById('icon-vol');
          const volume = document.getElementById('cc-volume');
          if (volIcon) volIcon.innerHTML = '<path d="M11 5L6 9H2v6h4l5 4V5zM15.54 8.46a5 5 0 0 1 0 7.07"/>';
          if (volume) { volume.value = 0.35; volume.style.setProperty('--val', '35%'); }
          
          if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
        });
      }

      const safePlay = async () => {
        try {
          await vid.play();
        } catch (e) {
          vid.muted = true;
          try {
            await vid.play();
            const volIcon = document.getElementById('icon-vol');
            const volume = document.getElementById('cc-volume');
            if (volIcon) volIcon.innerHTML = '<path d="M11 5L6 9H2v6h4l5 4V5z"></path><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line>';
            if (volume) { volume.value = 0; volume.style.setProperty('--val', '0%'); }
            
            if (unmuteOverlay) unmuteOverlay.style.display = 'flex';
          } catch (err) {}
        }
      };
      
      if (vid) {
        vid.volume = 0.35;
        vid.src = `https://sudothy.me/media/${encodeURIComponent(selectedVideo)}`;
        
        // Aspect ratio is handled dynamically via loadedmetadata listener

        if (lyricsContainer && typeof lyricsData !== 'undefined') {
          lyricsContainer.innerHTML = lyricsData.map((verse, vIdx) => `
            <div class="verse" id="verse-${vIdx}">
              ${verse.words.map((w, wIdx) => `<span class="word" id="word-${vIdx}-${wIdx}">${w.word} </span>`).join('')}
            </div>
          `).join('');
        }

        vid.load();
        safePlay();

        // Karaoke Engine
        let activeVerseIndex = -1;
        let activeWordIndex = -1;
        let animationFrameId = null;
        let inactivityTimer = null;
        
        let lastWordTime = Date.now();
        const sideLeft = document.getElementById('gab-side-left');
        const sideRight = document.getElementById('gab-side-right');
        const isDesktop = !window.matchMedia("(pointer: coarse)").matches;
        let currentSideWordLeftEl = null;
        let currentSideWordRightEl = null;
        let lastTopPos = 50;

        let isGlobalBridge = false;

        const updateLyrics = () => {
          const time = vid.currentTime - (typeof GLOBAL_OFFSET !== 'undefined' ? GLOBAL_OFFSET : 0);
          
          let newVerseIndex = -1;
          let newWordIndex = -1;
          
          if (time >= 0 && typeof lyricsData !== 'undefined') {
            for (let i = 0; i < lyricsData.length; i++) {
              if (time >= lyricsData[i].verseStart && time <= lyricsData[i].verseEnd) {
                newVerseIndex = i;
                for (let j = 0; j < lyricsData[i].words.length; j++) {
                  if (time >= lyricsData[i].words[j].start && time <= lyricsData[i].words[j].end) {
                    newWordIndex = j;
                    break;
                  }
                }
                break;
              }
            }
          }
          
          let verseChanged = false;
          if (newVerseIndex !== activeVerseIndex) {
            verseChanged = true;
            document.querySelectorAll('.verse.active').forEach(v => v.classList.remove('active'));
            if (newVerseIndex !== -1) {
              const newVerse = document.getElementById(`verse-${newVerseIndex}`);
              if (newVerse) newVerse.classList.add('active');
            }
            activeVerseIndex = newVerseIndex;
          }
          
          if (newWordIndex !== activeWordIndex || verseChanged) {
            document.querySelectorAll('.word.active').forEach(w => w.classList.remove('active'));
            
            if (newWordIndex !== -1 && newVerseIndex !== -1) {
              const newWord = document.getElementById(`word-${newVerseIndex}-${newWordIndex}`);
              if (newWord) newWord.classList.add('active');
              
              lastWordTime = Date.now();
              lyricsContainer.style.opacity = '1';
              
              if (isDesktop && selectedVideo === 'Gabrielle - 5 fine frøkner.mp4') {
                const currentVerseText = lyricsData[newVerseIndex].words.map(w => w.word).join('');
                const bridgePhrases = ["kjøre meg opp", "kjøre meg ned", "sprenge i kok", "ingen andre eg heller", "spiller ingen rolle"];
                const isBridge = bridgePhrases.some(p => currentVerseText.toLowerCase().includes(p.toLowerCase()));
                isGlobalBridge = isBridge;
                
                if (isBridge && sideLeft && sideRight) {
                  lyricsContainer.style.opacity = '0';
                  
                  if (currentSideWordLeftEl) {
                    currentSideWordLeftEl.classList.add('fade-out');
                    const toRemove = currentSideWordLeftEl;
                    setTimeout(() => toRemove.remove(), 600);
                  }
                  if (currentSideWordRightEl) {
                    currentSideWordRightEl.classList.add('fade-out');
                    const toRemove = currentSideWordRightEl;
                    setTimeout(() => toRemove.remove(), 600);
                  }
                  
                  const wordText = lyricsData[newVerseIndex].words[newWordIndex].word.trim();
                  if (wordText) {
                    const baseSize = 2 + Math.random() * 3; 
                    const finalSize = wordText.length > 8 ? baseSize / 1.5 : baseSize;
                    
                    let newTopPos;
                    let attempts = 0;
                    do {
                      newTopPos = Math.random() * 70 + 10;
                      attempts++;
                    } while (Math.abs(newTopPos - lastTopPos) < 20 && attempts < 10);
                    lastTopPos = newTopPos;
                    const topPos = newTopPos + '%';
                    
                    const wordElLeft = document.createElement('div');
                    wordElLeft.className = 'gab-side-word';
                    wordElLeft.textContent = wordText;
                    wordElLeft.style.fontSize = `min(${finalSize}rem, 80cqw)`;
                    wordElLeft.style.top = topPos;
                    
                    const wordElRight = document.createElement('div');
                    wordElRight.className = 'gab-side-word';
                    wordElRight.textContent = wordText;
                    wordElRight.style.fontSize = `min(${finalSize}rem, 80cqw)`;
                    wordElRight.style.top = topPos;
                    
                    sideLeft.appendChild(wordElLeft);
                    sideRight.appendChild(wordElRight);
                    
                    currentSideWordLeftEl = wordElLeft;
                    currentSideWordRightEl = wordElRight;
                  }
                } else {
                  lyricsContainer.style.opacity = '1';
                  if (currentSideWordLeftEl) {
                    currentSideWordLeftEl.classList.add('fade-out');
                    const toRemove = currentSideWordLeftEl;
                    setTimeout(() => toRemove.remove(), 600);
                    currentSideWordLeftEl = null;
                  }
                  if (currentSideWordRightEl) {
                    currentSideWordRightEl.classList.add('fade-out');
                    const toRemove = currentSideWordRightEl;
                    setTimeout(() => toRemove.remove(), 600);
                    currentSideWordRightEl = null;
                  }
                }
              }
              
              clearTimeout(inactivityTimer);
              inactivityTimer = setTimeout(() => {
                if (lyricsContainer) lyricsContainer.style.opacity = '0';
                if (currentSideWordLeftEl) {
                  currentSideWordLeftEl.classList.add('fade-out');
                  const toRemove = currentSideWordLeftEl;
                  setTimeout(() => toRemove.remove(), 600);
                  currentSideWordLeftEl = null;
                }
                if (currentSideWordRightEl) {
                  currentSideWordRightEl.classList.add('fade-out');
                  const toRemove = currentSideWordRightEl;
                  setTimeout(() => toRemove.remove(), 600);
                  currentSideWordRightEl = null;
                }
              }, 4000);
            }
            activeWordIndex = newWordIndex;
            activeVerseIndex = newVerseIndex;
          }
          
          animationFrameId = requestAnimationFrame(updateLyrics);
        };
        
        // Start the loop unconditionally
        animationFrameId = requestAnimationFrame(updateLyrics);
        
        vid.addEventListener('play', () => {
          if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
        });
        
        vid.addEventListener('pause', () => {
          // No longer canceling the animation frame here to keep updateLyrics running
        });
        
        vid.addEventListener('seeked', () => {
          if (!animationFrameId) {
            animationFrameId = requestAnimationFrame(() => {
              updateLyrics();
              cancelAnimationFrame(animationFrameId);
              animationFrameId = null;
            });
          }
        });
        
        // Custom UI Logic for Desktop
        if (isDesktop) {
          vid.removeAttribute('controls');
          
          const playBtn = document.getElementById('cc-play');
          const playIcon = document.getElementById('icon-play');
          const progress = document.getElementById('cc-progress');
          const timeDisp = document.getElementById('cc-time');
          const muteBtn = document.getElementById('cc-mute');
          const volIcon = document.getElementById('icon-vol');
          const volume = document.getElementById('cc-volume');
          const fsBtn = document.getElementById('cc-fullscreen');
          
          const formatTime = (time) => {
            if (isNaN(time)) return "0:00";
            const m = Math.floor(time / 60);
            const s = Math.floor(time % 60);
            return `${m}:${s.toString().padStart(2, '0')}`;
          };
          
          let isDragging = false;
          
          const togglePlay = () => {
            vid.paused ? vid.play() : vid.pause();
          };
          
          playBtn.addEventListener('click', togglePlay);
          vid.addEventListener('click', togglePlay);
          
          vid.addEventListener('play', () => {
            playIcon.innerHTML = '<path d="M6 4h4v16H6zm8 0h4v16h-4z"/>';
          });
          
          vid.addEventListener('pause', () => {
            playIcon.innerHTML = '<path d="M5 3l14 9-14 9v-18z"/>';
          });
          
          vid.addEventListener('timeupdate', () => {
            timeDisp.textContent = `${formatTime(vid.currentTime)} / ${formatTime(vid.duration)}`;
            if (!isDragging && vid.duration) {
              const pct = (vid.currentTime / vid.duration) * 100;
              progress.value = pct;
              progress.style.setProperty('--val', `${pct}%`);
            }
          });
          
          vid.addEventListener('loadedmetadata', () => {
            timeDisp.textContent = `0:00 / ${formatTime(vid.duration)}`;
          });
          
          progress.addEventListener('input', (e) => {
            isDragging = true;
            const pct = e.target.value;
            e.target.style.setProperty('--val', `${pct}%`);
            vid.currentTime = (pct / 100) * vid.duration;
          });
          
          progress.addEventListener('change', () => {
            isDragging = false;
          });
          
          muteBtn.addEventListener('click', () => {
            vid.muted = !vid.muted;
            if(vid.muted || vid.volume === 0) {
              volIcon.innerHTML = '<path d="M11 5L6 9H2v6h4l5 4V5zM23 9l-6 6M17 9l6 6"/>';
              volume.value = 0;
              volume.style.setProperty('--val', `0%`);
            } else {
              volIcon.innerHTML = '<path d="M11 5L6 9H2v6h4l5 4V5zM15.54 8.46a5 5 0 0 1 0 7.07"/>';
              volume.value = vid.volume;
              volume.style.setProperty('--val', `${vid.volume * 100}%`);
            }
          });
          
          volume.addEventListener('input', (e) => {
            const val = e.target.value;
            vid.volume = val;
            vid.muted = (val == 0);
            e.target.style.setProperty('--val', `${val * 100}%`);
            if(vid.muted) volIcon.innerHTML = '<path d="M11 5L6 9H2v6h4l5 4V5zM23 9l-6 6M17 9l6 6"/>';
            else volIcon.innerHTML = '<path d="M11 5L6 9H2v6h4l5 4V5zM15.54 8.46a5 5 0 0 1 0 7.07"/>';
          });
          
          fsBtn.addEventListener('click', () => {
            if (!document.fullscreenElement && !document.webkitFullscreenElement) {
              if (wrapper.requestFullscreen) wrapper.requestFullscreen();
              else if (wrapper.webkitRequestFullscreen) wrapper.webkitRequestFullscreen();
              else if (vid.webkitEnterFullscreen) vid.webkitEnterFullscreen();
            } else {
              if (document.exitFullscreen) document.exitFullscreen();
              else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
            }
          });
          
          // Auto-hide controls timeout
          let hideTimeout;
          wrapper.addEventListener('mousemove', () => {
            wrapper.classList.add('interacting');
            clearTimeout(hideTimeout);
            hideTimeout = setTimeout(() => wrapper.classList.remove('interacting'), 2000);
          });
        }
      }

      // 3. Vote System
      const btnLike = document.getElementById('btn-like');
      const btnDislike = document.getElementById('btn-dislike');
      let fileName = selectedVideo;
      
      const updateVoteUI = (l, d) => {
        if(l) btnLike.classList.add('active'); else btnLike.classList.remove('active');
        if(d) btnDislike.classList.add('active'); else btnDislike.classList.remove('active');
      };

      try {
        const res = await fetch(`/api/vote?file_name=${encodeURIComponent(fileName)}`, { cache: 'no-store' });
        if (res.ok) {
          const { liked, desliked } = await res.json();
          updateVoteUI(liked, desliked);
        }
      } catch (e) {}

      const castVote = async (action) => {
        const btn = action === 'like' ? btnLike : btnDislike;
        const otherBtn = action === 'like' ? btnDislike : btnLike;
        
        const currentlyActive = btn.classList.contains('active');
        if (currentlyActive) {
          btn.classList.remove('active');
        } else {
          btn.classList.add('active');
          otherBtn.classList.remove('active');
        }

        try {
          const res = await fetch('/api/vote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ file_name: fileName, action }),
            cache: 'no-store'
          });
          if (res.ok) {
            const { liked, desliked } = await res.json();
            updateVoteUI(liked, desliked);
          }
        } catch(e) {}
      };

      btnLike.addEventListener('click', () => castVote('like'));
      btnDislike.addEventListener('click', () => castVote('dislike'));

      const btnShuffle = document.getElementById('btn-shuffle');
      if (btnShuffle) {
        let isShuffling = false;
        btnShuffle.addEventListener('click', () => {
          if (isShuffling) return;
          isShuffling = true;
          
          let rem = availableVideos.filter(v => v !== selectedVideo);
          if (rem.length === 0) rem = availableVideos;
          const next = rem[Math.floor(Math.random() * rem.length)];
          playedVideos.push(next);
          localStorage.setItem('playedVideos', JSON.stringify(playedVideos));

          window.location.reload();
        });
      }

      // 5. Audio Spectrum Visualizer
      let audioCtx = null;
      let analyser = null;
      let dataArray = null;
      let bufferLength = 0;
      let vizDrawId = null;
      const canvasLeft = document.getElementById('viz-left');
      const canvasRight = document.getElementById('viz-right');
      const ctxLeft = canvasLeft?.getContext('2d');
      const ctxRight = canvasRight?.getContext('2d');
      
      const initAudio = () => {
        if (!audioCtx && vid) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          analyser = audioCtx.createAnalyser();
          const source = audioCtx.createMediaElementSource(vid);
          source.connect(analyser);
          analyser.connect(audioCtx.destination);
          analyser.fftSize = 512;
          analyser.smoothingTimeConstant = 0.85;
          bufferLength = analyser.frequencyBinCount;
          dataArray = new Uint8Array(bufferLength);
          drawVisualizer();
        }
      };

      const resizeCanvas = () => {
        if(canvasLeft && sideLeft) {
          canvasLeft.width = sideLeft.clientWidth;
          canvasLeft.height = sideLeft.clientHeight;
        }
        if(canvasRight && sideRight) {
          canvasRight.width = sideRight.clientWidth;
          canvasRight.height = sideRight.clientHeight;
        }
      };
      
      window.addEventListener('resize', resizeCanvas);
      resizeCanvas();

      const drawVisualizer = () => {
        vizDrawId = requestAnimationFrame(drawVisualizer);
        if (!isDesktop || selectedVideo !== 'Gabrielle - 5 fine frøkner.mp4' || vid.paused) {
          if (ctxLeft) ctxLeft.clearRect(0, 0, canvasLeft.width, canvasLeft.height);
          if (ctxRight) ctxRight.clearRect(0, 0, canvasRight.width, canvasRight.height);
          return;
        }
        
        analyser.getByteFrequencyData(dataArray);
        const wL = canvasLeft.width;
        const hL = canvasLeft.height;
        const wR = canvasRight.width;
        const hR = canvasRight.height;
        
        ctxLeft.clearRect(0, 0, wL, hL);
        ctxRight.clearRect(0, 0, wR, hR);
        const timeScale = Date.now() / 20;
        
        // Dynamic bar spacing for a sleeker look
        const totalBars = Math.floor(bufferLength * 0.75); // Cut off highest frequencies which are often empty
        const barHeightLeft = hL / totalBars;
        const barHeightRight = hR / totalBars;
        const gap = 1.5;
        
        ctxLeft.shadowBlur = 12;
        ctxRight.shadowBlur = 12;
        
        for(let i = 0; i < totalBars; i++) {
          const val = dataArray[i];
          // Apply a non-linear curve to make it look more dynamic
          const pct = Math.pow(val / 255, 1.5);
          
          // Minimum width for presence, maximum 40% of screen
          const barWidthLeft = Math.max(2, wL * 0.4 * pct);
          const barWidthRight = Math.max(2, wR * 0.4 * pct);
          
          if (isGlobalBridge) {
            const hue = ((i / totalBars) * 360 + timeScale) % 360;
            const color = `hsl(${hue}, 100%, 65%)`;
            ctxLeft.fillStyle = color;
            ctxLeft.shadowColor = color;
            ctxRight.fillStyle = color;
            ctxRight.shadowColor = color;
          } else {
            const opacity = 0.2 + pct * 0.8;
            const color = `rgba(255, 255, 255, ${opacity})`;
            ctxLeft.fillStyle = color;
            ctxLeft.shadowColor = `rgba(255, 255, 255, ${opacity * 0.5})`;
            ctxRight.fillStyle = color;
            ctxRight.shadowColor = `rgba(255, 255, 255, ${opacity * 0.5})`;
          }
          
          const yL = hL - (i * barHeightLeft) - barHeightLeft + (gap / 2);
          const drawH = Math.max(1, barHeightLeft - gap);
          
          // Draw left side (spawns from left edge)
          ctxLeft.fillRect(0, yL, barWidthLeft, drawH);
          
          // Draw right side (spawns from right edge)
          const yR = hR - (i * barHeightRight) - barHeightRight + (gap / 2);
          const drawHR = Math.max(1, barHeightRight - gap);
          ctxRight.fillRect(wR - barWidthRight, yR, barWidthRight, drawHR);
        }
      };

      vid.addEventListener('play', initAudio, { once: true });
    });

    document.addEventListener('contextmenu', e => e.preventDefault());
    document.addEventListener('keydown', e => {
      if (e.keyCode === 123 || 
         (e.ctrlKey && e.shiftKey && (e.keyCode === 73 || e.keyCode === 67 || e.keyCode === 74)) ||
         (e.ctrlKey && e.keyCode === 85)) {
        e.preventDefault();
        return false;
      }
    });
    
    // Check if devtools open via screen differential (no memory leak)
    setInterval(() => {
      if (window.outerWidth - window.innerWidth > 160 || window.outerHeight - window.innerHeight > 160) {
         document.body.innerHTML = '';
      }
    }, 2000);
  </script>
</body>
</html>
