---
const pageTitle = "Under maintenance...";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #000000;
      --fg: #ffffff;
      --fg-dim: rgba(255, 255, 255, 0.6);
    }
    
    html, body {
      margin: 0;
      padding: 0;
      width: 100vw;
      height: 100dvh;
      background-color: var(--bg);
      color: var(--fg);
      overflow: hidden;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      /* Anti-copy measures */
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      user-select: none;
      -webkit-user-drag: none;
    }

    .container {
      display: flex;
      flex-direction: column;
      height: 100%;
      padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
      box-sizing: border-box;
    }

    .header {
      text-align: center;
      padding: 2rem 1rem 1rem 1rem;
      flex-shrink: 0;
    }

    h1 {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(2rem, 5vw, 3.5rem);
      margin: 0 0 0.5rem 0;
      font-weight: 700;
      letter-spacing: 2px;
      text-shadow: 0 2px 10px rgba(255,0,0,0.2);
    }

    .subtitle {
      color: var(--fg-dim);
      font-size: clamp(0.9rem, 2vw, 1.1rem);
      margin: 0;
    }

    .video-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 1rem;
      min-height: 0;
    }

    video {
      width: 100%;
      max-width: 900px;
      max-height: 100%;
      box-shadow: 0 4px 30px rgba(255,255,255,0.05);
      border-radius: 8px;
      outline: none;
      background-color: #050505;
      /* Prevent pointer events on the video itself to make copying/inspecting harder? 
         No, they need play/pause controls */
    }

    .footer {
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      gap: 0.8rem;
    }

    .discord-contact {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.9rem;
      color: var(--fg-dim);
    }

    .pfp-mini-container {
      position: relative;
      width: 24px;
      height: 24px;
    }

    .pfp-mini-container img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      pointer-events: none;
    }

    .status-dot {
      position: absolute;
      bottom: -2px;
      right: -2px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: #80848e; /* Default offline */
      border: 2px solid var(--bg);
    }

    .github-link {
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--fg-dim);
      transition: color 0.2s;
    }

    .github-link:hover {
      color: var(--fg);
    }

    .github-link svg {
      width: 24px;
      height: 24px;
      fill: currentColor;
    }

    /* Aggressive anti-devtools overlay */
    #anti-inspect {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100vw; height: 100dvh;
      background: black;
      color: red;
      z-index: 999999;
      align-items: center;
      justify-content: center;
      font-family: monospace;
      font-size: 2rem;
    }
  </style>
</head>
<body oncontextmenu="return false;">
  <div id="anti-inspect"><h1>NICE TRY.</h1></div>
  
  <div class="container">
    <div class="header">
      <h1>{pageTitle}</h1>
      <p class="subtitle">In the meantime, here's a good anthem:</p>
    </div>

    <div class="video-wrapper">
      <video 
        id="anthem-video"
        src="https://media.thiago.qzz.io/media/Bring%20Me%20The%20Horizon%20-%20Go%20To%20Hell%2C%20For%20Heavens%20Sake.mp4" 
        controls 
        controlsList="nodownload noremoteplayback noplaybackrate"
        disablePictureInPicture
        playsinline
        preload="auto"
      ></video>
    </div>

    <div class="footer">
      <div class="discord-contact">
        <div class="pfp-mini-container">
          <img id="mini-pfp" src="/api/pfp" alt="PFP" />
          <div id="mini-status" class="status-dot"></div>
        </div>
        <span>Contact me on Discord: okaythi</span>
      </div>
      
      <a href="https://github.com/okaythi" class="github-link" target="_blank" rel="noopener noreferrer" title="GitHub">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
    </div>
  </div>

  <script>
    // 1. Fetch live presence
    document.addEventListener('DOMContentLoaded', async () => {
      const pfp = document.getElementById('mini-pfp');
      const stat = document.getElementById('mini-status');
      const colors = { online: '#23a559', idle: '#f0b232', dnd: '#f23f43', offline: '#80848e' };
      
      try {
        const apiUrl = 'https://media.thiago.qzz.io'; // Note: The user mentioned PUBLIC_BOT_API_URL before, but we can just use the proxy or fetch directly.
        // Wait, if it's running locally or deployed, we should use import.meta.env
        const url = import.meta.env?.PUBLIC_BOT_API_URL || '';
        if(url) {
            const res = await fetch(`${url}/api/me`);
            if (res.ok) {
                const data = await res.json();
                if (data.avatar_url) pfp.src = data.avatar_url;
                if (data.status) stat.style.backgroundColor = colors[data.status] || colors.offline;
            }
        }
      } catch (e) {}

      // 2. Setup video volume
      const vid = document.getElementById('anthem-video');
      if (vid) {
        vid.volume = 0.45;
        // Autoplay attempt
        vid.play().catch(e => {
            // Autoplay with sound blocked by browser, wait for user interaction
        });
      }
    });

    // 3. Absolute Hell Anti-DevTools / Anti-Copy
    // Disable right click, F12, Ctrl+Shift+I, Ctrl+Shift+C, Ctrl+Shift+J, Ctrl+U
    document.addEventListener('contextmenu', e => e.preventDefault());
    document.addEventListener('keydown', e => {
      if (e.keyCode === 123 || 
         (e.ctrlKey && e.shiftKey && (e.keyCode === 73 || e.keyCode === 67 || e.keyCode === 74)) ||
         (e.ctrlKey && e.keyCode === 85)) {
        e.preventDefault();
        document.getElementById('anti-inspect').style.display = 'flex';
        return false;
      }
    });
    
    // Aggressive debugger loop
    setInterval(() => {
      const before = new Date().getTime();
      debugger;
      const after = new Date().getTime();
      if (after - before > 100) {
        document.getElementById('anti-inspect').style.display = 'flex';
      }
    }, 1000);
  </script>
</body>
</html>
