---
import { ClientRouter } from 'astro:transitions';
import AntiCapture from '../components/AntiCapture.astro';
import MobileNav from '../components/MobileNav.astro';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Thy</title>
    <script>
      // Data is preloaded by Cloudflare Pages Middleware HTMLRewriter
    </script>
    <ClientRouter />
    <style is:global>
      :root {
        --bg: #050505;
        --fg: #f0f0f0;
        --accent: #a3a3a3;
        --border: rgba(255, 255, 255, 0.08);
        --glass-bg: rgba(255, 255, 255, 0.02);
        --glass-hover: rgba(255, 255, 255, 0.04);
      }
      body {
        margin: 0; padding: 0; background: var(--bg); color: var(--fg);
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
        min-height: 100dvh;
        padding-top: env(safe-area-inset-top, 20px);
        padding-bottom: env(safe-area-inset-bottom, 20px);
        padding-left: env(safe-area-inset-left, 20px);
        padding-right: env(safe-area-inset-right, 20px);
        overflow-x: hidden;
      }
      .container {
        max-width: 900px;
        margin: 0 auto;
        padding: clamp(2rem, 5vw, 6rem) clamp(1rem, 3vw, 2rem);
      }
      /* Desktop Navigation */
      .left-nav { position: fixed; bottom: max(4vh, 30px); left: 4vw; z-index: 100; display: flex; align-items: center; gap: 15px; }
      .nav-link { display: flex; align-items: center; justify-content: center; color: #444; text-decoration: none; transition: color 0.2s ease, transform 0.2s ease; -webkit-tap-highlight-color: transparent; }
      .nav-link:hover { color: #ffffff; transform: scale(1.05); }
      .nav-link svg { width: 28px; height: 28px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
      
      .pfp-container {
        display: flex; justify-content: center; margin-bottom: 4rem;
        position: relative;
      }
      .pfp-container::before {
        content: '';
        position: absolute;
        top: 50%; left: 50%;
        width: 140px; height: 140px;
        transform: translate(-50%, -50%);
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        border-radius: 50%;
        z-index: -1;
      }
      .pfp {
        width: clamp(100px, 15vw, 130px);
        height: clamp(100px, 15vw, 130px);
        border-radius: 50%;
        object-fit: cover;
        background-color: #111;
        border: 1px solid var(--border);
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;
      }
      .pfp:hover {
        transform: scale(1.05) translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.6), 0 0 20px rgba(255,255,255,0.05);
      }
      
      #blocks-root {
        display: flex;
        flex-direction: column;
        gap: clamp(3rem, 6vw, 5rem);
      }
      
      /* Block styling */
      .block {
        opacity: 0; transform: translateY(15px);
        transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .block.visible { opacity: 1; transform: translateY(0); }
      
      .category-title {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--accent);
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .category-title::after {
        content: "";
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, var(--border) 0%, transparent 100%);
      }
      
      /* Sleek Grid */
      .fields-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.25rem;
      }
      
      /* Full width for Bio or long text */
      .fields-grid:has(.field-card.is-bio) {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }
      
      .field-card {
        background: var(--glass-bg);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        position: relative;
        overflow: hidden;
      }
      .field-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: radial-gradient(circle at top left, rgba(255,255,255,0.03), transparent 70%);
        opacity: 0;
        transition: opacity 0.4s ease;
      }
      .field-card:hover {
        background: var(--glass-hover);
        border-color: rgba(255,255,255,0.15);
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
      }
      .field-card:hover::before {
        opacity: 1;
      }
      
      .playlist-banner {
        display: flex; align-items: center; justify-content: space-between; 
        padding: 0.8rem 1.2rem; margin: 0 auto 3rem auto; 
        background: var(--glass-bg); border: 1px solid var(--border); 
        border-radius: 30px; text-decoration: none; 
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); 
        max-width: 500px;
        position: relative; overflow: hidden;
      }
      .playlist-banner::before {
        content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0;
        background: radial-gradient(circle at top left, rgba(255,255,255,0.03), transparent 70%);
        opacity: 0; transition: opacity 0.4s ease;
      }
      .playlist-banner::after {
        content: ''; position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.06), transparent);
        animation: shimmerSweep 7s infinite cubic-bezier(0.25, 1, 0.5, 1);
        pointer-events: none;
      }
      @keyframes shimmerSweep {
        0% { left: -100%; }
        40% { left: 200%; }
        100% { left: 200%; }
      }
      .playlist-banner:hover {
        background: var(--glass-hover); border-color: rgba(255,255,255,0.15);
        transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0,0,0,0.3);
      }
      .playlist-banner:hover::before { opacity: 1; }
      .playlist-banner:hover .arrow-icon { transform: translateX(3px); color: var(--fg); }
      
      .field-label {
        font-weight: 600;
        color: var(--accent);
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        position: relative;
        z-index: 1;
      }
      
      .field-value {
        font-size: 1.1rem;
        line-height: 1.6;
        color: #e2e2e2;
        white-space: pre-wrap;
        font-weight: 300;
        position: relative;
        z-index: 1;
      }
      
      .empty-state {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        min-height: 40vh;
        text-align: center;
        font-style: italic;
        color: var(--accent);
        font-size: 1.2rem;
        font-weight: 300;
      }
      
      /* ===== MOBILE-NATIVE ===== */
      @media (max-width: 767px) {
        /* Top nav hidden — tab bar replaces navigation */
        .left-nav { display: none !important; }

        /* Container: no top padding needed (no fixed nav) + clear tab bar */
        .container {
          padding-top: max(env(safe-area-inset-top, 0px), 2rem);
          padding-bottom: calc(var(--mobile-bottom-pad, 72px) + 2rem);
          padding-left: max(env(safe-area-inset-left, 0px), 1rem);
          padding-right: max(env(safe-area-inset-right, 0px), 1rem);
        }

        /* Single column on phones */
        .fields-grid {
          grid-template-columns: 1fr;
        }
      }
      
      /* Thought Bubble */
      .thought-bubble {
        position: absolute; top: -10px; left: calc(100% - 10px);
        width: fit-content; max-width: 300px; min-width: 40px;
        background: #2a2a2a; border: 1px solid #444; border-radius: 20px;
        padding: 10px 14px; font-size: 13px; color: #eee;
        box-shadow: 0 4px 10px rgba(0,0,0,0.5); word-break: break-word;
        line-height: 1.4; z-index: 10; font-family: 'Inter', sans-serif;
      }
      .thought-bubble::before {
        content: ''; position: absolute; bottom: -6px; left: 16px;
        width: 12px; height: 12px; background: #2a2a2a; border: 1px solid #444;
        border-radius: 50%; box-shadow: inset -2px -2px 4px rgba(0,0,0,0.3);
      }
      .thought-bubble::after {
        content: ''; position: absolute; bottom: -16px; left: 6px;
        width: 6px; height: 6px; background: #2a2a2a; border: 1px solid #444;
        border-radius: 50%; box-shadow: inset -1px -1px 2px rgba(0,0,0,0.3);
      }

    </style>
  </head>
  <body>
    <div class="left-nav">
       <a href="/read" class="nav-link" aria-label="Read" title="Read"><svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg></a>
       <a href="/songs" class="nav-link" aria-label="Listen" title="Listen"><svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg></a>
       <a href="/coolpeople" class="nav-link" aria-label="Cool People" title="Cool People"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></a>
    </div>
    <main class="container" id="content-root">
      <div class="pfp-container" style="position:relative; width:130px; height:130px; margin: 0 auto 3rem auto;">
         <div style="position:relative; width:100%; height:100%; border-radius:50%; overflow:hidden;">
            <img id="about-pfp" src="/api/pfp" alt="thy" style="width:100%; height:100%; object-fit:cover;">
         </div>
         <!-- Status Bubble -->
         <div id="about-status-bubble" class="thought-bubble" style="display:none; position:absolute; top:-10px; left:calc(100% - 10px);">
            <span id="about-status-text">...</span>
         </div>
      </div>
      <a href="/songs" class="block visible playlist-banner">
         <div style="display: flex; align-items: center; gap: 0.8rem; overflow: hidden;">
            <div style="width: 32px; height: 32px; background: rgba(255,255,255,0.08); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 2px 8px rgba(0,0,0,0.2);">
               <svg viewBox="0 0 24 24" style="width: 14px; height: 14px; stroke: var(--fg); stroke-width: 2; fill: var(--fg); stroke-linecap: round; stroke-linejoin: round; transform: translateX(1px);"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            </div>
            <div style="display: flex; flex-direction: column;">
               <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--fg); position: relative; z-index: 1;">Playlist</span>
               <span style="font-size: 0.7rem; color: var(--accent); font-weight: 400; line-height: 1.4; white-space: normal; position: relative; z-index: 1;">My top songs in rotation (they change periodically and you can even suggest some cool ones !)</span>
            </div>
         </div>
         <svg viewBox="0 0 24 24" style="width: 16px; height: 16px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; transition: transform 0.3s ease, color 0.3s ease; color: var(--accent); margin-left: 0.5rem;" class="arrow-icon"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <div id="blocks-root">
        <div class="empty-state">Loading...</div>
      </div>
      <div id="academics-link-container" style="display: flex; justify-content: center; margin-top: 2rem; margin-bottom: 3rem;"></div>
    </main>
    
    <AntiCapture />

    <script src="/scripts/about-me.js" is:inline></script>
    <MobileNav current="home" />
  </body>
</html>
