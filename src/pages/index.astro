---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Thy</title>
    <style>
      html, body {
        margin: 0;
        padding: 0;
        width: 100vw;
        height: 100dvh; /* Dynamic Viewport Height fixes iOS cutoff */
        overflow: hidden;
        background-color: #000000;
        color: #d9d9d9;
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        box-sizing: border-box;
        
        /* Disable text selection */
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
      }

      .container {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        width: 100vw;
        height: 100dvh;
        padding: 4dvh 2vw;
        box-sizing: border-box;
      }

      .top-section {
        flex: 0 0 auto;
        padding-top: 2dvh;
      }

      h2 {
        font-size: clamp(1.2rem, 3vw, 2rem);
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-style: italic;
        margin: 0;
        color: #ffffff;
        opacity: 0.95;
      }

      .player-wrapper {
        flex: 1 1 auto;
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        width: 100%;
        max-width: 900px;
        height: 100%;
        overflow: hidden;
        gap: 1rem;
        padding: 2vh 0;
      }

      .video-container {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100%;
        width: 100%;
        max-width: 800px;
      }

      .loader {
        position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        font-size: clamp(1rem, 2vw, 1.5rem);
        font-weight: 900;
        letter-spacing: 4px;
        color: #ffffff;
        text-transform: uppercase;
        z-index: 10;
        pointer-events: none;
      }

      .spinner {
        width: clamp(1.2rem, 2.5vw, 1.8rem);
        height: clamp(1.2rem, 2.5vw, 1.8rem);
        border: 3px solid rgba(255, 255, 255, 0.2);
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: spin 1s linear infinite;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }

      video {
        width: 100%;
        max-height: 100%;
        object-fit: contain;
        border-radius: 2px;
        background-color: transparent;
        opacity: 0; 
        transition: opacity 0.4s ease-in; 
      }

      .nav-btn {
        background: none;
        border: none;
        padding: 10px;
        cursor: pointer;
        display: none;
        outline: none;
        -webkit-tap-highlight-color: transparent; /* Removes blue tap box on mobile */
      }

      .nav-btn svg {
        width: 30px;
        height: 40px;
        stroke: #444;
        stroke-width: 2;
        fill: none;
        transition: stroke 0.2s ease;
      }

      .nav-btn:hover svg {
        stroke: #ffffff;
      }

      .bottom-section {
        flex: 0 0 auto;
        text-align: center;
        padding-bottom: 2dvh;
      }

      .track-info {
        font-size: clamp(0.75rem, 1.5vw, 0.9rem);
        line-height: 1.6;
        color: #7a7a7a;
        max-width: 90vw;
        margin: 0 auto;
      }

      .track-title {
        color: #ffffff;
        font-weight: 700;
        letter-spacing: 0.5px;
      }

      footer {
        margin-top: 3vh;
        font-size: 0.65rem;
        color: #333333;
        text-transform: uppercase;
        letter-spacing: 2px;
      }

      /* --- MOBILE FIXES --- */
      @media (max-width: 768px) {
        .container {
          justify-content: center; /* Kills the massive black voids */
          gap: 2rem;
          padding: 2dvh 2vw;
        }
        
        .player-wrapper {
          flex: 0 0 auto; /* Stops wrapper from forcing itself to be full height */
          height: auto;
          gap: 0.25rem; /* Brings arrows closer to the video */
        }

        .video-container {
          height: auto;
        }

        video {
          max-height: 50dvh; /* Prevents vertical blowout */
        }

        .nav-btn {
          padding: 5px; /* Reclaims horizontal space for the video */
        }

        .nav-btn svg {
          width: 20px; /* Slims arrows slightly */
          height: 30px;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="top-section">
        <h2>"Cuno doesn't fucking care!"</h2>
      </div>

      <div class="player-wrapper">
        <button id="prev-btn" class="nav-btn" aria-label="Previous">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="video-container">
          <div id="loader" class="loader">
            <div class="spinner"></div>
            <span>LOADING...</span>
          </div>
          <video id="main-player" controls autoplay playsinline controlslist="nodownload" oncontextmenu="return false;"></video>
        </div>

        <button id="next-btn" class="nav-btn" aria-label="Next">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <div class="bottom-section">
        <div class="track-info">
          I'm thy and this page is a rotation of the music I've been listening to the most recently <br/><br/>
          &bull; Current track : <span id="track-name" class="track-title">Connecting...</span>
        </div>
        <footer>
          &copy; 2026
        </footer>
      </div>
    </div>

    <script>
      document.addEventListener('contextmenu', event => event.preventDefault());
      document.addEventListener('copy', event => {
        event.preventDefault();
        return false;
      });
      document.addEventListener('keydown', event => {
        if (event.key === 'F12') event.preventDefault();
        if (event.ctrlKey && event.shiftKey && (event.key === 'I' || event.key === 'i' || event.key === 'J' || event.key === 'j')) event.preventDefault();
        if (event.ctrlKey && (event.key === 'U' || event.key === 'u')) event.preventDefault();
      });

      const player = document.getElementById('main-player');
      const loader = document.getElementById('loader');
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');
      const trackNameEl = document.getElementById('track-name');
      
      let currentIndex = 0;
      let videoList = [];

      function extractName(url) {
        const filename = url.split('/').pop() || "";
        return decodeURIComponent(filename).replace(/\.[^/.]+$/, "");
      }

      function loadVideo(index) {
        if (!videoList || videoList.length === 0) {
          trackNameEl.textContent = "Oops, there's nothing to see here yet.";
          loader.style.display = 'none';
          return;
        }

        player.style.opacity = 0;
        loader.style.display = 'flex';

        const url = videoList[index];
        player.src = url;
        trackNameEl.textContent = extractName(url);
        
        player.play().catch(e => console.log("Autoplay prevented by browser."));

        prevBtn.style.display = index > 0 ? 'block' : 'none';
        nextBtn.style.display = index < videoList.length - 1 ? 'block' : 'none';
      }

      player.addEventListener('loadedmetadata', () => {
        loader.style.display = 'none';
        player.style.opacity = 1;
      });

      player.addEventListener('waiting', () => {
        loader.style.display = 'flex';
        player.style.opacity = 0.5;
      });

      player.addEventListener('playing', () => {
        loader.style.display = 'none';
        player.style.opacity = 1;
      });

      async function initialize() {
        try {
          const res = await fetch('/api/videos');
          videoList = await res.json();
          loadVideo(currentIndex);
        } catch(e) {
          trackNameEl.textContent = "Failed to load tracks.";
          loader.style.display = 'none';
        }
      }

      prevBtn.addEventListener('click', () => {
        if (currentIndex > 0) {
          currentIndex--;
          loadVideo(currentIndex);
        }
      });

      nextBtn.addEventListener('click', () => {
        if (currentIndex < videoList.length - 1) {
          currentIndex++;
          loadVideo(currentIndex);
        }
      });

      player.addEventListener('ended', () => {
        if (currentIndex < videoList.length - 1) {
          currentIndex++;
          loadVideo(currentIndex);
        }
      });

      initialize();
    </script>
  </body>
</html>
