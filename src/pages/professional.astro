---
import { ClientRouter } from 'astro:transitions';
import AntiCapture from '../components/AntiCapture.astro';
import MobileNav from '../components/MobileNav.astro';

let statusText = null;
let cropCoords = null;
let groups = {};
let hasBlocks = false;

try {
  const env = Astro.locals.runtime?.env;
  if (env && env.ABOUT_ME) {
    const { results } = await env.ABOUT_ME.prepare(`SELECT * FROM about_blocks WHERE type IN ('status', 'pfp_crop')`).all();
    results.forEach(b => {
       if (b.type === 'status' || b.id === 0) {
          statusText = b.content;
       } else if (b.type === 'pfp_crop' || b.id === -1) {
          try { cropCoords = JSON.parse(b.content); } catch(e) {}
       }
    });
  }
  
  if (env && env.PROFESSIONAL_PROFILE) {
    const { results } = await env.PROFESSIONAL_PROFILE.prepare(`SELECT * FROM professional_blocks ORDER BY order_index ASC`).all();
    hasBlocks = results && results.length > 0;
    results.forEach(b => {
       if (b.type === 'field') {
          try {
             const c = JSON.parse(b.content);
             if (c.category) {
                if(!groups[c.category]) groups[c.category] = [];
                groups[c.category].push(c);
             }
          } catch(e) {}
       }
    });
  }
} catch (e) {
  console.error("SSR Error:", e);
}

let pfpStyle = "width:100%; height:100%; object-fit:cover;";
if (cropCoords) {
  pfpStyle = `position:absolute; left:${cropCoords.x}%; top:${cropCoords.y}%; width:${cropCoords.w}%; height:${cropCoords.h}%; max-width:none; object-fit:fill; image-rendering:high-quality; transform:translateZ(0); will-change:transform;`;
}
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Professional Profile</title>
    <ClientRouter />
    <style is:global>
      :root {
        --bg: #050505;
        --fg: #f0f0f0;
        --accent: #a3a3a3;
        --border: rgba(255, 255, 255, 0.08);
        --glass-bg: rgba(255, 255, 255, 0.02);
        --glass-hover: rgba(255, 255, 255, 0.04);
      }
      body {
        margin: 0; padding: 0; background: var(--bg); color: var(--fg);
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
        min-height: 100dvh;
        padding-top: env(safe-area-inset-top, 20px);
        padding-bottom: env(safe-area-inset-bottom, 20px);
        padding-left: env(safe-area-inset-left, 20px);
        padding-right: env(safe-area-inset-right, 20px);
        overflow-x: hidden;
      }
      .container {
        max-width: 900px;
        margin: 0 auto;
        padding: clamp(2rem, 5vw, 6rem) clamp(1rem, 3vw, 2rem);
      }
      /* Desktop Navigation */
      .left-nav { position: fixed; bottom: max(4vh, 30px); left: 4vw; z-index: 100; display: flex; align-items: center; gap: 15px; }
      .nav-link { display: flex; align-items: center; justify-content: center; color: #444; text-decoration: none; transition: color 0.2s ease, transform 0.2s ease; -webkit-tap-highlight-color: transparent; }
      .nav-link:hover { color: #ffffff; transform: scale(1.05); }
      .nav-link svg { width: 28px; height: 28px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
      
      .pfp-container {
        display: flex; justify-content: center; margin-bottom: 1.5rem;
        position: relative;
      }
      .pfp-container::before {
        content: '';
        position: absolute;
        top: 50%; left: 50%;
        width: 140px; height: 140px;
        transform: translate(-50%, -50%);
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        border-radius: 50%;
        z-index: -1;
      }
      
      #blocks-root {
        display: flex;
        flex-direction: column;
        gap: clamp(3rem, 6vw, 5rem);
      }
      
      /* Block styling */
      .block {
        opacity: 0; transform: translateY(30px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .block.visible { opacity: 1; transform: translateY(0); }
      
      .category-title {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--accent);
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .category-title::after {
        content: "";
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, var(--border) 0%, transparent 100%);
      }
      
      /* Sleek Grid */
      .fields-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.25rem;
      }
      
      /* Full width for Bio or long text */
      .fields-grid:has(.field-card.is-bio) {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }
      
      .field-card {
        background: var(--glass-bg);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        position: relative;
        overflow: hidden;
      }
      .field-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: radial-gradient(circle at top left, rgba(255,255,255,0.03), transparent 70%);
        opacity: 0;
        transition: opacity 0.4s ease;
      }
      .field-card:hover {
        background: var(--glass-hover);
        border-color: rgba(255,255,255,0.15);
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
      }
      .field-card:hover::before {
        opacity: 1;
      }

      .field-label {
        font-weight: 600;
        color: var(--accent);
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        position: relative;
        z-index: 1;
      }
      
      .field-value {
        font-size: 1.1rem;
        line-height: 1.6;
        color: #e2e2e2;
        white-space: pre-wrap;
        font-weight: 300;
        position: relative;
        z-index: 1;
      }
      
      .empty-state {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        min-height: 40vh;
        text-align: center;
        font-style: italic;
        color: var(--accent);
        font-size: 1.2rem;
        font-weight: 300;
      }
      
      /* ===== MOBILE-NATIVE ===== */
      @media (max-width: 767px) {
        .left-nav { display: none !important; }
        .container {
          padding-top: max(env(safe-area-inset-top, 0px), 2rem);
          padding-bottom: calc(var(--mobile-bottom-pad, 72px) + 2rem);
          padding-left: max(env(safe-area-inset-left, 0px), 1rem);
          padding-right: max(env(safe-area-inset-right, 0px), 1rem);
        }
        .fields-grid {
          grid-template-columns: 1fr;
        }
      }
      
      /* Thought Bubble */
      .thought-bubble {
        position: absolute; top: -10px; left: calc(100% - 10px);
        width: max-content; max-width: 200px; min-width: 80px;
        background: #2a2a2a; border: 1px solid #444; border-radius: 20px;
        padding: 10px 16px; font-size: 13px; color: #eee;
        box-shadow: 0 4px 10px rgba(0,0,0,0.5); word-wrap: break-word;
        line-height: 1.4; z-index: 10; font-family: 'Inter', sans-serif;
      }
      .thought-bubble::before {
        content: ''; position: absolute; bottom: -6px; left: 16px;
        width: 12px; height: 12px; background: #2a2a2a; border: 1px solid #444;
        border-radius: 50%; box-shadow: inset -2px -2px 4px rgba(0,0,0,0.3);
      }
      .thought-bubble::after {
        content: ''; position: absolute; bottom: -16px; left: 6px;
        width: 6px; height: 6px; background: #2a2a2a; border: 1px solid #444;
        border-radius: 50%; box-shadow: inset -1px -1px 2px rgba(0,0,0,0.3);
      }
    </style>
  </head>
  <body>
    <div class="left-nav">
       <a href="/read" class="nav-link" aria-label="Read" title="Read"><svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg></a>
       <a href="/songs" class="nav-link" aria-label="Listen" title="Listen"><svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg></a>
       <a href="/coolpeople" class="nav-link" aria-label="Cool People" title="Cool People"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></a>
    </div>
    <main class="container">
      <div class="pfp-container" style="position:relative; width:130px; height:130px; margin: 0 auto 1.5rem auto;">
         <div style="position:relative; width:100%; height:100%; border-radius:50%; overflow:hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.5); border: 1px solid var(--border);">
            <img id="about-pfp" src="/api/pfp" alt="thy" style={pfpStyle}>
         </div>
         {statusText && (
           <div id="about-status-bubble" class="thought-bubble" style="position:absolute; top:-10px; left:calc(100% - 10px);">
              <span id="about-status-text">{statusText}</span>
           </div>
         )}
      </div>

      <div style="display: flex; justify-content: center; margin-bottom: 4rem;">
        <a href="/" class="back-btn">
          <svg viewBox="0 0 24 24" style="width: 14px; height: 14px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round;"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Back to main profile
        </a>
      </div>

      <div id="blocks-root">
        {!hasBlocks && (
          <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 50vh; text-align: center;">
            <h1 style="font-size: 4rem; margin: 0; color: var(--fg); letter-spacing: -2px;">404</h1>
            <p style="color: var(--accent); margin-top: 1rem; font-size: 1rem;">This profile hasn't been set up yet.</p>
            <a href="/" style="margin-top: 2rem; color: var(--fg); text-decoration: none; border-bottom: 1px solid var(--border); padding-bottom: 0.2rem; transition: border-color 0.2s ease;">Return home</a>
          </div>
        )}
        
        {Object.entries(groups).map(([category, fields]) => {
          const validFields = fields.filter(f => f.value && f.value.trim() !== '');
          if (validFields.length === 0) return null;
          return (
            <div class="block">
              <div class="category-title">{category}</div>
              <div class="fields-grid">
                {validFields.map(f => {
                  const isBio = f.label.toLowerCase().includes('bio') || (f.value && f.value.length > 100);
                  const cardClass = isBio ? 'field-card is-bio' : 'field-card';
                  return (
                    <div class={cardClass}>
                      <div class="field-label">{f.label}</div>
                      <div class="field-value">{f.value}</div>
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })}
      </div>
    </main>
    
    <AntiCapture />
    <MobileNav current="home" />

    <style is:inline>
      .back-btn {
        display: inline-flex; align-items: center; gap: 0.5rem; background: transparent; 
        border: 1px solid var(--border); padding: 0.5rem 1.2rem; border-radius: 30px; 
        color: var(--accent); text-decoration: none; font-size: 0.75rem; font-weight: 600; 
        text-transform: uppercase; letter-spacing: 1px; transition: all 0.2s ease;
      }
      .back-btn:hover { background: var(--glass-hover); border-color: rgba(255,255,255,0.15); color: var(--fg); transform: translateX(-3px); }
    </style>

    <script is:inline>
      document.addEventListener('astro:page-load', () => {
        const pfp = document.getElementById('about-pfp');
        if (pfp) {
           pfp.addEventListener('error', () => {
              pfp.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23888"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>';
           });
        }
        
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        }, { rootMargin: '50px 0px', threshold: 0.1 });
        document.querySelectorAll('.block').forEach(el => observer.observe(el));
      });
    </script>
  </body>
</html>
