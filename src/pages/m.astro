---
const pageTitle = "I'm cooking something here...";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no" />
  <title>{pageTitle}</title>
  <link rel="icon" type="image/png" href="https://media.thiago.qzz.io/media/vanity/pentagram.png" />
  <link rel="apple-touch-icon" href="https://media.thiago.qzz.io/media/vanity/pentagram.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #000000;
      --fg: #ffffff;
      --fg-dim: rgba(255, 255, 255, 0.6);
    }
    
    html, body {
      margin: 0;
      padding: 0;
      width: 100vw;
      height: 100dvh;
      background-color: var(--bg);
      color: var(--fg);
      overflow: hidden;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      user-select: none;
      touch-action: pan-x pan-y;
    }

    .container {
      display: flex;
      flex-direction: column;
      height: 100%;
      padding-top: calc(env(safe-area-inset-top) + 12px);
      padding-bottom: calc(env(safe-area-inset-bottom) + 16px);
      box-sizing: border-box;
    }

    .top-anchor {
      text-align: center;
      padding: 0.5rem 1rem;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    h1 {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(1.32rem, 3.77vw, 2.07rem);
      margin: 0;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-shadow: 0 2px 10px rgba(255,0,0,0.15);
    }

    .subtitle {
      color: var(--fg-dim);
      font-size: 0.95rem;
      font-weight: 500;
      letter-spacing: 0.02em;
      margin: 0;
    }

    .video-wrapper {
      width: 100vw;
      max-width: 100vw;
      aspect-ratio: 16 / 9;
      background-color: #050505;
      position: relative;
      flex-shrink: 0;
    }

    video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .touch-grid {
      position: absolute;
      inset: 0;
      z-index: 10;
      display: flex;
    }
    .touch-half {
      flex: 1;
      height: 100%;
    }

    .action-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 12px 16px;
      box-sizing: border-box;
      flex-shrink: 0;
    }
    
    .left-controls {
      display: flex;
      justify-content: flex-start;
    }

    .vote-controls {
      display: flex;
      gap: 16px;
      justify-content: flex-end;
    }

    .action-btn {
      background: none;
      border: none;
      padding: 0;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      color: var(--fg-dim);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.2s, transform 0.1s;
    }
    
    #btn-shuffle {
      width: auto;
      padding: 0 12px;
      border-radius: 24px;
      gap: 8px;
    }
    
    #btn-shuffle span {
      font-size: 0.9rem;
      font-weight: 500;
      letter-spacing: 0.02em;
    }
    
    .action-btn:active {
      transform: scale(0.9);
    }
    
    .action-btn.active {
      color: var(--fg);
    }
    
    .action-btn.active svg {
      fill: currentColor;
    }

    .action-btn svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .lyrics-container {
      flex: 1;
      position: relative;
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 0 16px;
    }

    :global(.lyrics-stage) {
      flex: 1;
      display: grid;
      grid-template-areas: "verse";
      place-items: center;
      text-align: center;
      font-size: 1.3rem;
      font-weight: 700;
      width: 100%;
      height: 100%;
    }

    :global(.verse) {
      grid-area: verse;
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
      width: 100%;
      text-wrap: balance;
      line-height: 1.4;
      max-height: 100%;
      overflow-y: auto;
    }

    :global(.verse.active) {
      opacity: 1;
      pointer-events: auto;
    }

    :global(.word) {
      display: inline-block;
      white-space: pre-wrap;
      margin-right: 0.25em;
      transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), text-shadow 0.2s, -webkit-text-stroke 0.2s, color 0.2s;
      will-change: transform;
      color: rgba(255, 255, 255, 0.3);
    }

    :global(.word.active) {
      transform: scale(1.15) !important;
      color: #fff !important;
      text-shadow: 0 0 12px rgba(255, 255, 255, 0.8) !important;
      -webkit-text-stroke: 1px rgba(255,255,255,0.2) !important;
    }

    :global(.word.scream-orange) {
      color: #ffa52c !important;
      transform: scale(1.15) translateZ(0) !important;
      text-shadow: 0 0 20px #ff0018, 0 0 10px #ffa52c !important;
      -webkit-text-stroke: 1px rgba(255, 255, 255, 0.2) !important;
      z-index: 10;
      position: relative;
    }

    .custom-controls {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(transparent, rgba(0,0,0,0.85) 40%, #000);
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 24px 16px 12px 16px;
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 30;
      overflow: hidden;
      pointer-events: none;
    }

    .video-wrapper:hover .custom-controls,
    .video-wrapper.interacting .custom-controls,
    .video-wrapper.paused .custom-controls {
      opacity: 1;
      pointer-events: auto;
    }

    .custom-controls button {
      background: none;
      border: none;
      color: #fff;
      cursor: pointer;
      padding: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0.8;
      transition: opacity 0.2s, transform 0.1s;
    }

    .custom-controls button:active {
      transform: scale(0.9);
    }

    .custom-controls svg {
      width: 24px;
      height: 24px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    #cc-play svg {
      fill: currentColor;
      stroke: none;
    }

    .cc-time {
      font-size: 0.8rem;
      font-variant-numeric: tabular-nums;
      color: #ccc;
      white-space: nowrap;
    }

    .cc-progress-container {
      flex: 1;
      position: relative;
      display: flex;
      align-items: center;
    }

    input[type=range] {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      background: transparent;
      cursor: pointer;
      height: 24px;
      margin: 0;
    }
    
    input[type=range]::-webkit-slider-runnable-track {
      width: 100%;
      height: 4px;
      background: linear-gradient(to right, #fff var(--val, 0%), rgba(255,255,255,0.2) var(--val, 0%));
      border-radius: 2px;
    }
    
    input[type=range]::-moz-range-track {
      width: 100%;
      height: 4px;
      background: linear-gradient(to right, #fff var(--val, 0%), rgba(255,255,255,0.2) var(--val, 0%));
      border-radius: 2px;
    }

    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      height: 16px;
      width: 16px;
      border-radius: 50%;
      background: #fff;
      margin-top: -6px;
      box-shadow: 0 0 5px rgba(0,0,0,0.5);
    }

    .unmute-btn {
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.3);
      padding: 12px 24px;
      border-radius: 30px;
      font-size: 1.1rem;
      font-weight: 600;
      backdrop-filter: blur(4px);
      transition: background 0.2s, transform 0.1s;
      color: #fff;
    }

    .footer-anchor {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }

    .contact-module {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 6px 6px 6px 10px;
      background: rgba(255, 255, 255, 0.04);
      border-radius: 32px;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .contact-module-divider {
      width: 1px;
      height: 18px;
      background: rgba(255, 255, 255, 0.15);
    }

    .contact-line {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1rem;
      color: var(--fg);
      font-weight: 500;
      letter-spacing: 0.01em;
    }

    .pfp-mini {
      position: relative;
      width: 32px;
      height: 32px;
    }
    .pfp-mini img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
    }
    .status-dot {
      position: absolute;
      bottom: -1px;
      right: -1px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background-color: #80848e;
      border: 2px solid #1a1a1a;
    }

    .social-link {
      color: var(--fg);
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
      transition: background 0.2s, transform 0.1s;
    }
    .social-link:active {
      transform: scale(0.95);
    }
    .social-link svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }

    @media (orientation: landscape) {
      .container {
        padding: 0 !important;
      }
      .top-anchor, .action-bar, .lyrics-stage, .footer-anchor {
        display: none !important;
      }
      .video-wrapper {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100dvh;
        max-width: none;
        max-height: none;
        aspect-ratio: auto;
        z-index: 100;
        background: #000;
      }
      video {
        object-fit: contain;
      }
    }
    
    .unmute-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 20;
      color: #fff;
      font-weight: 600;
      font-size: 1.2rem;
      border: none;
      padding: 0;
      margin: 0;
      cursor: pointer;
      appearance: none;
      -webkit-appearance: none;
      outline: none;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="top-anchor">
      <h1>{pageTitle}</h1>
      <p class="subtitle" id="anthem-subtitle">In the meantime, here's a good anthem:</p>
    </div>

    <div class="video-wrapper" id="video-wrapper">
      <button id="unmute-overlay" class="unmute-overlay" style="display: none;">
        <span class="unmute-btn">Tap to Unmute</span>
      </button>
      <video 
        id="anthem-video"
        playsinline
        preload="auto"
        controlsList="nodownload noremoteplayback noplaybackrate"
        disablePictureInPicture
        autoplay
      ></video>
      <div class="touch-grid" id="touch-grid">
        <div class="touch-half" id="touch-left"></div>
        <div class="touch-half" id="touch-right"></div>
      </div>
      
      <div class="custom-controls" id="custom-controls">
        <button id="cc-play" aria-label="Play/Pause">
          <svg viewBox="0 0 24 24" id="icon-play"><path d="M5 3l14 9-14 9v-18z"/></svg>
        </button>
        <span class="cc-time" id="cc-time">0:00 / 0:00</span>
        <div class="cc-progress-container">
          <input type="range" id="cc-progress" min="0" max="100" value="0" step="0.1" style="--val: 0%;">
        </div>
      </div>
    </div>

    <div class="action-bar">
      <div class="left-controls">
        <div class="action-btn" id="btn-shuffle">
          <svg viewBox="0 0 24 24"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"></path></svg>
          <span>Shuffle song</span>
        </div>
      </div>
      <div class="vote-controls">
        <div class="action-btn" id="btn-like">
          <svg viewBox="0 0 24 24"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path></svg>
        </div>
        <div class="action-btn" id="btn-dislike">
          <svg viewBox="0 0 24 24"><path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h2a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-2"></path></svg>
        </div>
      </div>
    </div>

    <div class="lyrics-container">
      <div class="lyrics-stage" id="lyrics-stage"></div>
    </div>

    <div class="footer-anchor">
      <div class="contact-module">
        <div class="contact-line">
          <div class="pfp-mini">
            <img id="mini-pfp" src="/api/pfp" alt="PFP" />
            <div id="mini-status" class="status-dot"></div>
          </div>
          <span><span style="opacity: 0.6">Discord:</span> <span id="discord-username">okaythi</span></span>
        </div>
        <div class="contact-module-divider"></div>
        <a href="https://github.com/okaythi" class="social-link" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <script>
    import { songsDictionary } from '../data/lyrics.ts';

    document.addEventListener('DOMContentLoaded', async () => {
      // Basic Presence
      const pfp = document.getElementById('mini-pfp');
      const stat = document.getElementById('mini-status');
      const usernameSpan = document.getElementById('discord-username');
      const colors = { online: '#23a559', idle: '#f0b232', dnd: '#f23f43', offline: '#80848e' };
      
      const updatePresence = async () => {
        try {
          const res = await fetch('https://gewoonthy.onrender.com/api/me', { cache: 'no-store' });
          if (res.ok) {
              const data = await res.json();
              if (data.avatar_url && pfp) pfp.src = data.avatar_url;
              if (data.status && stat) stat.style.backgroundColor = colors[data.status] || colors.offline;
              if (data.username && usernameSpan) usernameSpan.textContent = data.username;
          }
        } catch (e) {}
      };
      await updatePresence();
      setInterval(updatePresence, 15000);

      // Video Selection
      const availableVideos = Object.keys(songsDictionary);
      let playedVideos = [];
      let isNewVisitor = true;
      try {
        const stored = localStorage.getItem('playedVideos');
        if (stored) {
            playedVideos = JSON.parse(stored);
            if (playedVideos.length > 0) isNewVisitor = false;
        }
      } catch (e) {}

      let remaining = availableVideos.filter(v => !playedVideos.includes(v));
      if (remaining.length === 0) {
        const lastPlayed = playedVideos[playedVideos.length - 1];
        playedVideos = [lastPlayed];
        remaining = availableVideos.filter(v => v !== lastPlayed);
      }

      let selectedVideo;
      if (isNewVisitor && availableVideos.includes('Gabrielle - 5 fine frøkner.mp4')) {
        selectedVideo = 'Gabrielle - 5 fine frøkner.mp4';
      } else {
        selectedVideo = remaining[Math.floor(Math.random() * remaining.length)];
      }
      
      playedVideos.push(selectedVideo);
      localStorage.setItem('playedVideos', JSON.stringify(playedVideos));

      let songData = songsDictionary[selectedVideo];
      let lyricsData = songData.lyricsData;
      let GLOBAL_OFFSET = songData.globalOffset || 0;
      const subtitleEl = document.getElementById('anthem-subtitle');
      if (subtitleEl) subtitleEl.textContent = songData.subtitle || 'In the meantime, check out this banger:';

      const vid = document.getElementById('anthem-video');
      const lyricsStage = document.getElementById('lyrics-stage');
      const unmuteOverlay = document.getElementById('unmute-overlay');
      
      let wakeLock = null;
      const requestWakeLock = async () => {
        try {
          if ('wakeLock' in navigator) wakeLock = await navigator.wakeLock.request('screen');
        } catch (err) {}
      };

      if (vid) {
        vid.volume = 1.0;
        vid.src = `https://media.thiago.qzz.io/media/${encodeURIComponent(selectedVideo)}`;
        
        if (lyricsStage && typeof lyricsData !== 'undefined') {
          lyricsStage.innerHTML = lyricsData.map((verse, vIdx) => `
            <div class="verse" id="verse-${vIdx}">
              ${verse.words.map((w, wIdx) => `<span class="word" id="word-${vIdx}-${wIdx}">${w.word} </span>`).join('')}
            </div>
          `).join('');
        }

        let audioCtx;
        try {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          audioCtx = new AudioContext();
        } catch (e) {}

        const safePlay = async () => {
          try {
            await vid.play();
            requestWakeLock();
          } catch (e) {
            vid.muted = true;
            try {
              await vid.play();
              requestWakeLock();
              if (unmuteOverlay) unmuteOverlay.style.display = 'flex';
            } catch (err) {}
          }
        };

        if (unmuteOverlay) {
          const handleUnmute = (e) => {
            e.stopPropagation();
            vid.muted = false;
            if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
            unmuteOverlay.style.display = 'none';
          };
          unmuteOverlay.addEventListener('click', handleUnmute, { passive: true });
        }

        vid.load();
        safePlay();

        // Screen Wake Lock
        vid.addEventListener('play', requestWakeLock);
        vid.addEventListener('pause', async () => {
          if (wakeLock !== null) {
            await wakeLock.release();
            wakeLock = null;
          }
        });

        document.addEventListener('visibilitychange', async () => {
          if (wakeLock !== null && document.visibilityState === 'visible' && !vid.paused) {
            requestWakeLock();
          }
        });

        // Kinetic Lyric Engine
        let activeVerseIndex = -1;
        let activeWordIndex = -1;
        let animationFrameId = null;
        let bridgePhrases = ["kjøre meg opp", "kjøre meg ned", "sprenge i kok", "ingen andre eg heller", "spiller ingen rolle"];
        let isGabrielle = selectedVideo === 'Gabrielle - 5 fine frøkner.mp4';
        
        const updateLyrics = () => {
          const time = vid.currentTime - GLOBAL_OFFSET;
          let newVerseIndex = -1;
          let newWordIndex = -1;
          
          if (time >= 0 && lyricsData) {
            for (let i = 0; i < lyricsData.length; i++) {
              if (time >= lyricsData[i].verseStart && time <= lyricsData[i].verseEnd) {
                newVerseIndex = i;
                for (let j = 0; j < lyricsData[i].words.length; j++) {
                  if (time >= lyricsData[i].words[j].start && time <= lyricsData[i].words[j].end) {
                    newWordIndex = j;
                    break;
                  }
                }
                break;
              }
            }
          }
          
          if (newVerseIndex !== activeVerseIndex) {
            document.querySelectorAll('.verse.active').forEach(v => v.classList.remove('active'));
            if (newVerseIndex !== -1) {
              const nv = document.getElementById(`verse-${newVerseIndex}`);
              if (nv) nv.classList.add('active');
            }
            activeVerseIndex = newVerseIndex;
          }
          
          if (newWordIndex !== activeWordIndex) {
            document.querySelectorAll('.word.active').forEach(w => {
              w.classList.remove('active', 'scream-orange');
              w.style.willChange = 'auto'; // aggressively strip
            });
            
            if (newWordIndex !== -1 && newVerseIndex !== -1) {
              const nw = document.getElementById(`word-${newVerseIndex}-${newWordIndex}`);
              if (nw) {
                nw.classList.add('active');
                
                if (isGabrielle) {
                  const currentVerseText = lyricsData[newVerseIndex].words.map(w => w.word).join('');
                  const isBridge = bridgePhrases.some(p => currentVerseText.toLowerCase().includes(p.toLowerCase()));
                  if (isBridge) {
                    nw.classList.add('scream-orange');
                    nw.style.willChange = 'transform';
                    if (navigator.vibrate) navigator.vibrate([10]); // Soft caress
                  }
                }
              }
            }
            activeWordIndex = newWordIndex;
          }
          animationFrameId = requestAnimationFrame(updateLyrics);
        };
        animationFrameId = requestAnimationFrame(updateLyrics);

        // Gesture Logic
        let lastTapTime = 0;
        let lastTapZone = ''; // 'left' or 'right'
        
        const handleTap = (zone) => {
          const now = Date.now();
          if (now - lastTapTime < 300 && lastTapZone === zone) {
            // Double tap
            if (zone === 'left') {
              vid.currentTime = Math.max(0, vid.currentTime - 10);
            } else {
              vid.currentTime = Math.min(vid.duration, vid.currentTime + 10);
            }
            lastTapTime = 0; // reset
          } else {
            // Single tap logic (debounced to wait for potential double tap)
            setTimeout(() => {
              if (Date.now() - lastTapTime >= 300) {
                vid.paused ? vid.play() : vid.pause();
              }
            }, 300);
            lastTapTime = now;
            lastTapZone = zone;
          }
        };

        const tLeft = document.getElementById('touch-left');
        const tRight = document.getElementById('touch-right');
        
        tLeft.addEventListener('touchstart', () => handleTap('left'), { passive: true });
        tRight.addEventListener('touchstart', () => handleTap('right'), { passive: true });
        
        // Custom Controls logic
        const wrapper = document.getElementById('video-wrapper');
        const playBtn = document.getElementById('cc-play');
        const playIcon = document.getElementById('icon-play');
        const progress = document.getElementById('cc-progress');
        const timeDisp = document.getElementById('cc-time');
        
        const formatTime = (t) => {
          if (isNaN(t)) return "0:00";
          const m = Math.floor(t / 60);
          const s = Math.floor(t % 60);
          return `${m}:${s.toString().padStart(2, '0')}`;
        };
        
        let isDragging = false;
        
        const togglePlay = () => {
          vid.paused ? vid.play() : vid.pause();
        };
        
        playBtn.addEventListener('click', (e) => { e.stopPropagation(); togglePlay(); });
        
        vid.addEventListener('play', () => {
          playIcon.innerHTML = '<path d="M6 4h4v16H6zm8 0h4v16h-4z"/>';
          wrapper.classList.remove('paused');
          if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
        });
        
        vid.addEventListener('pause', () => {
          playIcon.innerHTML = '<path d="M5 3l14 9-14 9v-18z"/>';
          wrapper.classList.add('paused');
        });
        
        vid.addEventListener('timeupdate', () => {
          timeDisp.textContent = `${formatTime(vid.currentTime)} / ${formatTime(vid.duration)}`;
          if (!isDragging && vid.duration) {
            const pct = (vid.currentTime / vid.duration) * 100;
            progress.value = pct;
            progress.style.setProperty('--val', `${pct}%`);
          }
        });
        
        vid.addEventListener('loadedmetadata', () => {
          timeDisp.textContent = `0:00 / ${formatTime(vid.duration)}`;
        });
        
        progress.addEventListener('input', (e) => {
          isDragging = true;
          const pct = e.target.value;
          e.target.style.setProperty('--val', `${pct}%`);
          vid.currentTime = (pct / 100) * vid.duration;
        });
        
        progress.addEventListener('change', () => {
          isDragging = false;
        });
        
        // Auto-hide controls timeout on touch
        let hideTimeout;
        wrapper.addEventListener('touchstart', () => {
          wrapper.classList.add('interacting');
          clearTimeout(hideTimeout);
          hideTimeout = setTimeout(() => {
             if (!vid.paused) wrapper.classList.remove('interacting');
          }, 3000);
        }, { passive: true });

      }

      // Voting & Shuffle
      const btnLike = document.getElementById('btn-like');
      const btnDislike = document.getElementById('btn-dislike');
      const btnShuffle = document.getElementById('btn-shuffle');
      
      const updateVoteUI = (l, d) => {
        l ? btnLike.classList.add('active') : btnLike.classList.remove('active');
        d ? btnDislike.classList.add('active') : btnDislike.classList.remove('active');
      };

      try {
        const res = await fetch(`/api/vote?file_name=${encodeURIComponent(selectedVideo)}`, { cache: 'no-store' });
        if (res.ok) {
          const { liked, desliked } = await res.json();
          updateVoteUI(liked, desliked);
        }
      } catch (e) {}

      const castVote = async (action) => {
        const btn = action === 'like' ? btnLike : btnDislike;
        const otherBtn = action === 'like' ? btnDislike : btnLike;
        
        const currentlyActive = btn.classList.contains('active');
        if (currentlyActive) {
          btn.classList.remove('active');
        } else {
          btn.classList.add('active');
          otherBtn.classList.remove('active');
        }

        try {
          const res = await fetch('/api/vote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ file_name: selectedVideo, action }),
            cache: 'no-store'
          });
          if (res.ok) {
            const { liked, desliked } = await res.json();
            updateVoteUI(liked, desliked);
          }
        } catch(e) {}
      };

      btnLike.addEventListener('click', (e) => { e.stopPropagation(); castVote('like'); });
      btnDislike.addEventListener('click', (e) => { e.stopPropagation(); castVote('dislike'); });
      
      btnShuffle.addEventListener('click', (e) => {
        e.stopPropagation();
        let rem = availableVideos.filter(v => v !== selectedVideo);
        if (rem.length === 0) rem = availableVideos;
        playedVideos.push(rem[Math.floor(Math.random() * rem.length)]);
        localStorage.setItem('playedVideos', JSON.stringify(playedVideos));
        window.location.reload();
      });
    });
  </script>
</body>
</html>
